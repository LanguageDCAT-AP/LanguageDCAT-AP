@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix edc:     <https://w3id.org/edc/v0.0.1/ns/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix adms:    <http://www.w3.org/ns/adms#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ms:      <http://w3id.org/meta-share/meta-share/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix dcatlds: <http://w3id.org/lang-dcat-ap/> . # OK
@prefix it6:     <http://data.europa.eu/it6/> .
@prefix lds:     <https://language-data-space.eu/entity/> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .

sh:PolicyRoot
	a                    sh:NodeShape ;
	sh:applicableIn      "LanguageDCAT-AP:*:POLICY" ;
	sh:closed            true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:targetSubjectsOf  edc:policy ;
	sh:property          [
		                     sh:path     edc:policy ;
		                     sh:minCount 1 ;
		                     sh:maxCount 1 ;
		                     sh:class    odrl:Set ;
		                     sh:node     sh:PolicyNodeShape
	                     ] .


# LDS-specific: Only additional properties are checked; properties for prohibitions, permissions & constraints are under EDC control
sh:PolicyNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:*:POLICY" ;
	sh:targetClass  odrl:Set ;
	sh:property     sh:TitleProp,
	                sh:AlternativeProp,
	                sh:DescriptionProp,
	                sh:AdmsIdentifierProp,
	                sh:ConformsProp,
	                [
		                sh:path     cc:legalcode ;
		                sh:maxCount 1 ;
		                sh:nodeKind sh:IRI ;
		                sh:pattern  "^https?://.+$" ;
		                sh:message  "Invalid value for legal code URL: Value must be a valid URL"
	                ] .

# LDS-specific
sh:AssetRoot
	a                    sh:NodeShape ;
	sh:applicableIn      "LanguageDCAT-AP:*:CORPUS",
	                     "LanguageDCAT-AP:*:LCR",
	                     "LanguageDCAT-AP:*:MLMODEL",
	                     "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:closed            true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:targetSubjectsOf  edc:properties ;
	sh:property          sh:AssetPropertyShape ;
	sh:property          [
		                     sh:path    edc:dataAddress ;
		                     sh:node    sh:DataAddressDispatcher ;
		                     sh:message "edc:dataAddress must match either HttpData or AmazonS3 shape"
	                     ] .

# LDS-specific
sh:DataAddressDispatcher
	a          sh:NodeShape ;
	sh:or      ( sh:HttpData
	             sh:AmazonS3 ) ;
	sh:message "dataAddress must match either HttpData or AmazonS3 shape" .

# LDS-specific
sh:AssetPropertyShape
	a               sh:PropertyShape ;
	sh:applicableIn "LanguageDCAT-AP:*:CORPUS",
	                "LanguageDCAT-AP:*:LCR",
	                "LanguageDCAT-AP:*:MLMODEL",
	                "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:class        edc:Asset ;
	sh:path         edc:properties ;
	sh:minCount     1 ;
	sh:maxCount     1 .

# LDS-specific
sh:AssetNodeShape
	a                    sh:NodeShape ;
	sh:applicableIn      "LanguageDCAT-AP:*:CORPUS",
	                     "LanguageDCAT-AP:*:LCR",
	                     "LanguageDCAT-AP:*:MLMODEL",
	                     "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:closed            true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:targetClass       edc:Asset .
# sh:property is populated based on the sh:applicableIn property of individual property shapes, so we cannot specify
#a sh:property constraint here without causing conflicts.
# Instead, we will rely on the sh:applicableIn property of individual property shapes to ensure that the correct
# properties are present for each asset type and version.

# LDS-specific
sh:HttpData
	a                    sh:NodeShape ;
	sh:applicableIn      "LanguageDCAT-AP:*:CORPUS",
	                     "LanguageDCAT-AP:*:LCR",
	                     "LanguageDCAT-AP:*:MLMODEL",
	                     "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:closed            true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:property          [
		                     sh:path     edc:type ;
		                     sh:hasValue "HttpData" ;
		                     sh:message  "Expected type 'HttpData'" ;
	                     ],
	                     [
		                     sh:path     edc:baseUrl ;
		                     sh:pattern  "^https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)$" ;
		                     sh:maxCount 1 ;
		                     sh:minCount 1 ;
		                     sh:message  "edc:baseUrl is required and must be a valid URL"
	                     ],
	                     [
		                     sh:path     edc:name ;
		                     sh:datatype xsd:string ;
		                     sh:maxCount 1 ;
		                     sh:minCount 1 ;
		                     sh:message  "edc:name is required and must be a string"
	                     ],
	                     [
		                     sh:path         edc:requiresAuth ;
		                     sh:datatype     xsd:string ;
		                     sh:defaultValue "true" ;
		                     sh:maxCount     1 ;
		                     sh:message      "edc:requiresAuth must be a string"
	                     ],
	                     [
		                     sh:path     edc:storageSolutionId ;
		                     sh:datatype xsd:string ;
		                     sh:maxCount 1 ;
		                     sh:message  "edc:storageSolutionId must be a string"
	                     ] .


# LDS-specific
sh:AmazonS3
	a                    sh:NodeShape ;
	sh:applicableIn      "LanguageDCAT-AP:*:CORPUS",
	                     "LanguageDCAT-AP:*:LCR",
	                     "LanguageDCAT-AP:*:MLMODEL",
	                     "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:closed            true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:path              edc:dataAddress ;
	sh:property          [
		                     sh:path     edc:type ;
		                     sh:hasValue "AmazonS3" ;
		                     sh:message  "Expected type 'AmazonS3'" ;
	                     ],
	                     [
		                     sh:path     edc:objectName ;
		                     sh:datatype xsd:string ;
		                     sh:minCount 1 ;
		                     sh:maxCount 1 ;
		                     sh:message  "edc:objectName is required and must be a string"
	                     ],
	                     [
		                     sh:path     edc:s3type ;
		                     sh:datatype xsd:string ;
		                     sh:minCount 1 ;
		                     sh:maxCount 1 ;
		                     sh:message  "edc:s3type is required and must be a string"
	                     ],
	                     [
		                     sh:path         edc:requiresAuth ;
		                     sh:datatype     xsd:string ;
		                     sh:defaultValue "true" ;
		                     sh:maxCount     1 ;
		                     sh:message      "edc:requiresAuth must be a string"
	                     ],
	                     [
		                     sh:path     edc:storageSolutionId ;
		                     sh:datatype xsd:string ;
		                     sh:maxCount 1 ;
		                     sh:message  "edc:storageSolutionId must be a string"
	                     ] .

sh:AgentNodeShape
	a           sh:NodeShape ;
	sh:or       ( [ sh:class foaf:Person ] [ sh:class foaf:Organization ] ) ;
	sh:property [
		            sh:path       foaf:name ;
		            sh:datatype   rdf:langString ;
		            sh:uniqueLang true ;
		            sh:minCount   1 ;
		            sh:message    "foaf:name is required and must be a string"
	            ],
	            [
		            sh:path     adms:identifier ;
		            sh:property [
			                        sh:path     skos:notation ;
			                        sh:datatype xsd:string ;
			                        sh:message  "Notation (skos:notation) must be a string"
		                        ],
		                        [
			                        sh:path     skos:notation ;
			                        sh:minCount 1 ;
			                        sh:maxCount 1 ;
			                        sh:message  "Notation (skos:notation) is either missing or provided multiple times"
		                        ],
		                        [
			                        sh:path       adms:schemaAgency ;
			                        sh:datatype   rdf:langString ;
			                        sh:uniqueLang true ;
			                        sh:message    "Schema agency (adms:schemaAgency) must be a langString"
		                        ]
	            ] .

sh:DocumentNodeShape
	a           sh:NodeShape ;
	sh:property [
		            sh:path       ms:citationText ;
		            sh:datatype   rdf:langString ;
		            sh:uniqueLang true ;
		            sh:minCount   1
	            ],
	            [
		            sh:path     adms:identifier ;
		            sh:property [
			                        sh:path     skos:notation ;
			                        sh:datatype xsd:string ;
			                        sh:pattern  "^https?:\\/\\/(?:www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b(?:[-a-zA-Z0-9()@:%_\\+.~#?&\\/=]*)$" ;
			                        sh:message  "ADMS identifier (adms:Identifier/skos:notation) must be a valid URI"
		                        ],
		                        [
			                        sh:path     skos:notation ;
			                        sh:minCount 1 ;
			                        sh:maxCount 1 ;
			                        sh:message  "Notation (skos:notation) is either missing or provided multiple times"
		                        ],
		                        [
			                        sh:path       adms:schemaAgency ;
			                        sh:datatype   rdf:langString ;
			                        sh:uniqueLang true ;
			                        sh:message    "Schema agency (adms:schemaAgency) must be a langString"
		                        ]
	            ] .

#LDS-specific; missing properties (accessURL, downloadURL, accessService, hasPolicy, license)
sh:DistributionNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:*:CORPUS",
	                "LanguageDCAT-AP:*:LCR",
	                "LanguageDCAT-AP:0.9.3:MLMODEL" ;
	sh:class        dcat:Distribution ;
	sh:property     [
		                sh:path       dct:title ;
		                sh:uniqueLang true ;
		                sh:datatype   rdf:langString ;
		                sh:message    "dct:title is required and must be a langString"
	                ],
	                [
		                sh:path     ms:size ;
		                sh:node     sh:SizeNodeShape ;
		                sh:minCount 1 ;
		                sh:message  "ms:size is required"
	                ],
	                [
		                sh:path     dcat:packageFormat ;
		                sh:node     sh:PackageFormatRestriction ;
		                sh:nodeKind sh:IRI ;
		                sh:maxCount 1
	                ],
	                [
		                sh:path     dcat:byteSize ;
		                sh:datatype xsd:integer ;
		                sh:maxCount 1 ;
		                sh:message  "dcat:byteSize must be an integer"
	                ],
	                [
		                sh:path     dcatlds:format ;
		                sh:minCount 1 ;
		                sh:node     sh:DataFormatRestriction ;
		                sh:nodeKind sh:IRI
	                ] .

sh:SizeNodeShape
	a           sh:NodeShape ;
	sh:property [
		            sh:path    ms:amount ;
		            sh:or      ( [ sh:datatype xsd:double ; ] [ sh:datatype xsd:long ; ] [ sh:datatype xsd:integer ; ] ) ;
		            sh:message "Invalid ms:amount type"
	            ],
	            [
		            sh:path         ms:amount ;
		            sh:minExclusive 0 ;
		            sh:message      "Amount (ms:amount) must be a positive number"
	            ],
	            [
		            sh:path     ms:sizeUnit ;
		            sh:node     sh:SizeUnitRestriction ;
		            sh:message  "The provided value for unit (ms:sizeUnit) is invalid" ;
		            sh:nodeKind sh:IRI
	            ],
	            [
		            sh:path     ms:sizeUnit ;
		            sh:minCount 1 ;
		            sh:maxCount 1 ;
		            sh:message  "Size unit (ms:sizeUnit) is either missing or provided multiple times"
	            ] .

sh:TemporalShape
	a           sh:NodeShape ;
	sh:property [
		            sh:path     dcat:startDate ;
		            sh:datatype xsd:date ;
		            sh:minCount 1 ;
		            sh:maxCount 1 ;
		            sh:message  "Start date (dcat:startDate) is required and must be a date"
	            ],
	            [
		            sh:path     dcat:endDate ;
		            sh:datatype xsd:date ;
		            sh:minCount 1 ;
		            sh:maxCount 1 ;
		            sh:message  "End date (dcat:endDate) is required and must be a date"
	            ] .

# LDS-specific
sh:MsLanguageResourceNodeShape
	a           sh:NodeShape ;
	sh:property sh:TitleProp,
	            [
		            sh:path     adms:identifier ;
		            sh:property [
			                        sh:path     adms:identifier ;
			                        sh:property [
				                                    sh:path     skos:notation ;
				                                    sh:datatype xsd:string ;
				                                    sh:message  "Notation (skos:notation) must be a string"
			                                    ],
			                                    [
				                                    sh:path     skos:notation ;
				                                    sh:minCount 1 ;
				                                    sh:maxCount 1 ;
				                                    sh:message  "Notation (skos:notation) is either missing or provided multiple times"
			                                    ],
			                                    [
				                                    sh:path       adms:schemaAgency ;
				                                    sh:datatype   rdf:langString ;
				                                    sh:uniqueLang true ;
				                                    sh:message    "Schema agency (adms:schemaAgency) must be a langString"
			                                    ]
		                        ] ;
	            ],
	            [
		            sh:path       dct:description ;
		            sh:datatype   rdf:langString ;
		            sh:uniqueLang true ;
	            ] .

sh:MsLanguageNodeShape
	a           sh:NodeShape ;
	sh:class    ms:Language ;
	sh:property [
		            sh:path     ms:languageCode ;
		            sh:node     sh:LanguageRestriction ;
		            sh:nodeKind sh:IRI ;
		            sh:minCount 1 ;
		            sh:maxCount 1 ;
		            sh:message  "ms:languageCode is required and must be a valid language code IRI from ms:LanguageTaxonomy"
	            ],
	            [
		            sh:path     ms:region ;
		            sh:node     sh:LocationRestriction ;
		            sh:nodeKind sh:IRI ;
		            sh:maxCount 1 ;
	            ],
	            [
		            sh:path     ms:script ;
		            sh:node     sh:ScriptRestriction ;
		            sh:nodeKind sh:IRI ;
		            sh:maxCount 1 ;
	            ],
	            [
		            sh:path     ms:variant ;
		            sh:node     sh:VariantRestriction ;
		            sh:nodeKind sh:IRI ;
	            ],
	            [
		            sh:path       ms:languageVarietyName ;
		            sh:datatype   rdf:langString ;
		            sh:uniqueLang true ;
		            sh:message    "ms:languageVarietyName must be a langString"
	            ] .

# LDS-specific; missing properties (hasPolicy, dct:license); extra condition for mandatory accessLocation or downloadLocation 
sh:ModelDistributionNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:0.9.5:MLMODEL" ;
	sh:property     [
		                sh:path     ms:size ;
		                sh:node     sh:SizeNodeShape ;
		                sh:minCount 1 ;
		                sh:message  "ms:size is required"
	                ],
	                [
		                sh:path     dcat:byteSize ;
		                sh:datatype xsd:integer ;
		                sh:maxCount 1 ;
		                sh:message  "dcat:byteSize must be an integer"
	                ],
	                [
		                sh:path       dcatlds:distributionMethod ;
		                sh:uniqueLang true ;
		                sh:datatype   rdf:langString ;
		                sh:minCount   1 ;
		                sh:message    "dcatlds:distributionMethod is required and must be a langString"
	                ],
	                [
		                sh:path         dcatlds:tokensPerParameter ;
		                sh:datatype     xsd:integer ;
		                sh:minExclusive 0 ;
		                sh:maxCount     1 ;
		                sh:message      "dcatlds:tokensPerParameter must be a positive integer"
	                ],
	                [
		                sh:path       dcatlds:accessLevel ;
		                sh:uniqueLang true ;
		                sh:datatype   rdf:langString ;
		                sh:minCount   1 ;
		                sh:message    "dcatlds:accessLevel is required and must be a langString"
	                ],
	                [
		                sh:path         dcatlds:amountOfActiveParameters ;
		                sh:datatype     xsd:integer ;
		                sh:minExclusive 0 ;
		                sh:maxCount     1 ;
		                sh:message      "dcatlds:amountOfActiveParameters must be a positive integer"
	                ],
	                [
		                sh:path     dcatlds:format ;
		                sh:minCount 1 ;
		                sh:node     sh:DataFormatRestriction ;
		                sh:nodeKind sh:IRI ;
		                sh:message  "dcatlds:format is required and must be a valid data format IRI from the \"File Type\" Authority Table of the EU Publications Office"
	                ],
	                [
		                sh:path       dct:title ;
		                sh:uniqueLang true ;
		                sh:datatype   rdf:langString ;
		                sh:message    "dct:title must be a langString"
	                ],
	                [
		                sh:path     ms:mediaType ;
		                sh:node     sh:MediaTypeRestriction ;
		                sh:nodeKind sh:IRI ;
	                ],

	                [
		                sh:path     ms:accessLocation ;
		                sh:maxCount 1 ;
		                sh:datatype xsd:anyURI ;
		                sh:message  "ms:accessLocation must be a valid URI"
	                ],
	                [
		                sh:path     ms:downloadLocation ;
		                sh:maxCount 1 ;
		                sh:datatype xsd:anyURI ;
		                sh:message  "ms:downloadLocation must be a valid URI"
	                ] ;
	sh:xone         ( [
		                  sh:path     ms:accessLocation ;
		                  sh:minCount 1 ;
		                  sh:maxCount 1 ;
		                  sh:message  "ms:accessLocation must be a valid URI"
	                  ] [
		                  sh:path     ms:downloadLocation ;
		                  sh:minCount 1 ;
		                  sh:maxCount 1 ;
		                  sh:message  "ms:downloadLocation must be a valid URI"
	                  ] ) .

sh:ModalityNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:0.9.5:MLMODEL" ;
	sh:property     [
		                sh:path     ms:mediaType ;
		                sh:node     sh:MediaTypeRestriction ;
		                sh:nodeKind sh:IRI ;
		                sh:minCount 1 ;
		                sh:message  "ms:mediaType is required and must be a valid media type IRI from ms:MediaTypeTaxonomy"
	                ] .

sh:BenchmarkNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:0.9.5:MLMODEL" ;
	sh:targetClass  it6:Benchmark ;
	sh:property     sh:TitleProp,
	                [
		                sh:path       dct:description ;
		                sh:datatype   rdf:langString ;
		                sh:uniqueLang true ;
	                ],
	                [
		                sh:path     adms:identifier ;
		                sh:property [
			                            sh:path     skos:notation ;
			                            sh:datatype xsd:string ;
			                            sh:message  "Notation (skos:notation) must be a string"
		                            ],
		                            [
			                            sh:path     skos:notation ;
			                            sh:minCount 1 ;
			                            sh:maxCount 1 ;
			                            sh:message  "Notation (skos:notation) is either missing or provided multiple times"
		                            ],
		                            [
			                            sh:path       adms:schemaAgency ;
			                            sh:datatype   rdf:langString ;
			                            sh:uniqueLang true ;
			                            sh:message    "Schema agency (adms:schemaAgency) must be a langString"
		                            ]
	                ] .

sh:EnvironmentalImpactNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:0.9.5:MLMODEL" ;
	sh:property     [
		                sh:path       it6:measurementMethodology ;
		                sh:uniqueLang true ;
		                sh:datatype   rdf:langString ;
		                sh:message    "it6:measurementMethodology must be a langString"
	                ],
	                [
		                sh:path     it6:powerConsumption ;
		                sh:datatype xsd:string ;
		                sh:minCount 1 ;
		                sh:maxCount 1 ;
		                sh:message  "it6:powerConsumption is required and must be a string"
	                ] .

# LDS-specific; missing properties (hasPolicy, license)
sh:SoftwareDistributionNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:property     [
		                sh:path     ms:softwareDistributionForm ;
		                sh:node     sh:SoftwareDistributionFormRestriction ;
		                sh:nodeKind sh:IRI ;
		                sh:minCount 1 ;
		                sh:maxCount 1 ;
		                sh:message  "ms:softwareDistributionForm is required and must be a valid software distribution form IRI from ms:SoftwareDistributionFormTaxonomy"
	                ],
	                [
		                sh:path     ms:executionLocation ;
		                sh:datatype xsd:anyURI ;
		                sh:maxCount 1 ;
		                sh:message  "ms:executionLocation must be a valid URI"
	                ],
	                [
		                sh:path     ms:downloadLocation ;
		                sh:maxCount 1 ;
		                sh:datatype xsd:anyURI ;
		                sh:message  "ms:downloadLocation must be a valid URI"
	                ],
	                [
		                sh:path     ms:accessLocation ;
		                sh:datatype xsd:anyURI ;
		                sh:maxCount 1 ;
		                sh:message  "ms:accessLocation must be a valid URI"
	                ] .

sh:ProcessingResourceNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:property     [
		                sh:path     ms:processingResourceType ;
		                sh:node     sh:ProcessingResourceTypeRestriction ;
		                sh:nodeKind sh:IRI ;
		                sh:minCount 1 ;
		                sh:maxCount 1 ;
		                sh:message  "ms:processingResourceType is required and must be a valid IRI from ms:ProcessingResourceTypeTaxonomy"
	                ],
	                [
		                sh:path ms:language ;
		                sh:node sh:MsLanguageNodeShape ;
	                ],
	                [
		                sh:path     ms:mediaType ;
		                sh:node     sh:MediaTypeRestriction ;
		                sh:nodeKind sh:IRI ;
		                sh:message  "ms:mediaType is required and must be a valid media type IRI from ms:MediaTypeTaxonomy"
	                ],
	                [
		                sh:path     dcatlds:format ;
		                sh:node     sh:DataFormatRestriction ;
		                sh:nodeKind sh:IRI ;
	                ] .

sh:EvaluationNodeShape
	a               sh:NodeShape ;
	sh:applicableIn "LanguageDCAT-AP:0.9.5:MLMODEL" ;
	sh:property     [
		                sh:path     it6:hasBenchmark ;
		                sh:minCount 1 ;
		                sh:maxCount 1 ;
		                sh:node     sh:BenchmarkNodeShape ;
		                sh:message  "it6:hasBenchmark is required and must be a valid BenchmarkNodeShape"
	                ],
	                [
		                sh:path       dcatlds:evaluationOutput ;
		                sh:uniqueLang true ;
		                sh:datatype   rdf:langString ;
	                ],
	                [
		                sh:path       dcatlds:task ;
		                sh:uniqueLang true ;
		                sh:datatype   rdf:langString ;
	                ],
	                [
		                sh:path       dcatlds:metric ;
		                sh:uniqueLang true ;
		                sh:datatype   rdf:langString ;
	                ] .