# Global property shapes
# Introduce ad hoc property "sh:applicableIn" to specify the class (or classes) for which the property shape
# is applicable, to be used in validation reports for better error messages.

sh:LrTypePropVal
	a               sh:PropertyShape ;
	sh:applicableIn "LanguageDCAT-AP:*:CORPUS",
	                "LanguageDCAT-AP:*:LCR",
	                "LanguageDCAT-AP:*:MLMODEL",
	                "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:path         ms:lrType ;
	sh:nodeKind     sh:IRI ;
	sh:node         sh:LRTypeRestriction ;
	sh:message      "The provided value for language resource type (ms:lrType) is invalid" .

sh:LrTypePropCRD
	a               sh:PropertyShape ;
	sh:applicableIn "LanguageDCAT-AP:*:CORPUS",
	                "LanguageDCAT-AP:*:LCR",
	                "LanguageDCAT-AP:*:MLMODEL",
	                "LanguageDCAT-AP:*:TOOLSERVICE" ;
	sh:path         ms:lrType ;
	sh:minCount     1 ;
	sh:maxCount     1 ;
	sh:message      "Language resource type (ms:lrType) is either missing or provided multiple times" .

sh:ConformsProp
	a           sh:PropertyShape ;
	sh:path     dct:conformsTo ;
	sh:nodeKind sh:IRI ;
	sh:minCount 1 ;
	sh:node     sh:ConformsToRestriction .


sh:AdmsIdentifierProp
	a        sh:PropertyShape ;
	sh:path  adms:identifier ;
	sh:class adms:Identifier .

sh:TitleProp
	a             sh:PropertyShape ;
	sh:path       dct:title ;
	sh:datatype   rdf:langString ;
	sh:uniqueLang true ;
	sh:minCount   1 ;
	sh:message    "\"Title\" property (dct:title) is required"@en .

