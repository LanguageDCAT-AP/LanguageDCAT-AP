omtd:WikipediaFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Wikipedia format"@en ;
    skos:definition "Formats used for wikipedia"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:Blikiwikipedia,
        omtd:WikipediaArticle,
        omtd:WikipediaArticleInfo,
        omtd:WikipediaDiscussion,
        omtd:WikipediaLink,
        omtd:WikipediaPage,
        omtd:WikipediaQuery,
        omtd:WikipediaRevision,
        omtd:WikipediaRevisionPair,
        omtd:WikipediaTemplateFilteredArticle ;
    skos:prefLabel "Wikipedia format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

