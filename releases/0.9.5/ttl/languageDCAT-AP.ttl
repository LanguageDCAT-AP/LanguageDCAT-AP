        "Text categorisation"@en-gb .

omtd:TextCompression a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Text compression"@en ;
    rdfs:comment "The task/process of obtaining a more condensed representation of the information contained in a text"@en ;
    skos:broader omtd:SupportOperation ;
    skos:definition "Methods for text compression identify and exploit redundancy in text documents in order to obtain a more condensed representation of the information, from which the original data can be recovered without modification (lossless compression). In theory, there is a close relation between compression and prediction: The better a statistical language model can estimate the probability of a word, given some context, the more the text as a whole can be compressed."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Text compression"@en .

omtd:TextEncryption a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Text encryption"@en ;
    rdfs:comment "The task/process of converting readable text into an unreadable format (ciphertext) using a secret key"@en ;
    skos:broader omtd:Anonymization ;
    skos:definition "A cryptosystem or cipher system is a method of disguising messages so that only certain people can see through the disguise. Cryptography is the art of creating and using cryptosystems. Cryptanalysis is the art of breaking cryptosystems---seeing through the disguise even when you're not supposed to be able to. Cryptology is the study of both cryptography and cryptanalysis."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Text encryption"@en .

omtd:TextSimilarityAssessment a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Text similarity assessment"@en ;
    rdfs:comment "The task of determining the degree of closeness between two pieces of text"@en ;
    skos:altLabel "Text similarity checking"@en,
        "Textual similarity assessment"@en,
        "Textual similarity checking"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:SentenceSimilarityAssessment ;
    skos:prefLabel "Text similarity assessment"@en .

