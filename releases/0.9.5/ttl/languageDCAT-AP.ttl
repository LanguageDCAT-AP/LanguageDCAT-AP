omtd:PackageFormatScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Package Format Taxonomy"@en ;
    rdfs:seeAlso "https://vocabularies.ilsp.gr/showvoc/#/datasets/Package_Format_Taxonomy/data"@en ;
    skos:prefLabel "Package Format Taxonomy"@en .

omtd:Search a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Search"@en ;
    rdfs:comment "The act of looking for a unit of text in a dataset"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Search"@en .

omtd:SpeechProcessingCollection a omtd:Operation,
        owl:NamedIndividual,
        skos:Collection ;
    rdfs:label "Speech Processing Collection"@en ;
