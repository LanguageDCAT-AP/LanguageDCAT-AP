    skos:prefLabel "Speech-to-Text translation"@en .

omtd:SpellChecking a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Spell checking"@en ;
    rdfs:comment "Techniques for the identification of spelling or typing errors in textual documents, which may be applied interactively during the creation of the document, or off-line for existing documents. Spelling correction is an extension in which for each assumed error one or several hypothetical corrections are suggested."@en,
        "The task/process of checking the accuracy of spelling of a word (and usually correcting it) according to the accepted form"@en ;
    skos:altLabel "Spelling correction"@en ;
    skos:broader omtd:AuthoringSupport ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Spell checking"@en .

omtd:SpokenLanguageUnderstanding a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Spoken Language Understanding"@en ;
    rdfs:comment "The task of assigning a semantic interpretation to a spoken input, by making use of syntactic and semantic knowledge, which is often specific to a particular application domain"@en ;
    skos:broader omtd:NaturalLanguageUnderstanding,
        omtd:SpeechRecognition ;
    skos:definition "Spoken language understanding is the task of assigning a semantic interpretation to a spoken input, by making use of syntactic and semantic knowledge, which is often specific to a particular application domain. Spoken language understanding can involve dealing with multiple recognition hypotheses from a speech recogniser, taking prosodic properties of utterances into account and having to deal with fragmentary and grammatically incorrect utterances. Commercial speech recognisers often are accompanied by analysis tools. In commercial applications such as dialogue systems and command and control, spoken language understanding generally involves the construction of a task and domain-specific interpretation of the utterance."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Spoken Language Understanding"@en .

omtd:StanceDetection a omtd:Operation,
