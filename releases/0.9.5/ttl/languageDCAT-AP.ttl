    skos:narrower omtd:Compound,
        omtd:DerivationalFeature,
        omtd:Lemma,
        omtd:MorphologicalFeature,
        omtd:Stem,
        omtd:Word ;
    skos:prefLabel "Morphological annotation type"@en ;
    skos:topConceptOf omtd:AnnotationTypeScheme .

