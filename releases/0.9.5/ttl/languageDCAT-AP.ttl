omtd:Chunk a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Chunk"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.syntax.type.chunk.Chunk" ;
    skos:broader omtd:SyntacticAnnotationType ;
    skos:definition "Group of words that function together; a chunk normally includes a head and some consecutive (i.e. without gaps) preceding words"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Chunk"@en .

omtd:Clause a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Clause"@en ;
    skos:broader omtd:StructuralAnnotationType ;
    skos:definition "A clause is a subdivision of a sentence containing a subject (argument) and predicate. It is possible to have a word that implies or refers to a predicate rather than one explicitly stated. [Pei & Gaynor 1980: 40, http://linguistics-ontology.org/gold/2010/Clause]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Clause"@en .

omtd:Compound a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Compound"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.segmentation.type.Compound" ;
    skos:broader omtd:MorphologicalAnnotationType ;
    skos:definition "A single word composed of two or more free morphemes"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Compound"@en .

omtd:ComputerAidedTranslation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Computer-aided translation"@en ;
    rdfs:comment "A form of translation performed by a human translator with the aid of software programmes"@en ;
    skos:altLabel "CAT"@en,
        "Computer-assisted translation"@en,
        "MAHT"@en,
        "Machine-aided human translation"@en ;
    skos:broader omtd:MachineTranslation ;
    skos:definition "Techniques that help to increase the productivity of human translators via suitable computational infrastructure, including translation memories, terminology management, partial machine translation, online lexicons, or other techniques that automate parts of the translator's work, such as speech recognition or accelerated typing techniques applied to human translations."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Computer-aided translation"@en .

omtd:ConstituencyTree a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Constituency tree"@en ;
    skos:broader omtd:SyntacticAnnotationType ;
    skos:definition "An ordered, rooted tree that represents the syntactic structure of a string according to a constituency grammar (= phrase structure grammars). It distinguishes between terminal and non-terminal nodes. The interior nodes are labelLed by non-terminal categories of the grammar (phrases), while the leaf nodes are labelLed by terminal categories (parts of speech). [adapted from https://en.wikipedia.org/wiki/Parse_tree]"@en-gb,
        "An ordered, rooted tree that represents the syntactic structure of a string according to a constituency grammar (= phrase structure grammars). It distinguishes between terminal and non-terminal nodes. The interior nodes are labeled by non-terminal categories of the grammar (phrases), while the leaf nodes are labeled by terminal categories (parts of speech). [adapted from https://en.wikipedia.org/wiki/Parse_tree]"@en-us ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Constituency tree"@en .

omtd:Constituent a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Constituent"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.syntax.type.constituent.Constituent" ;
    skos:broader omtd:SyntacticAnnotationType ;
    skos:definition "A word or group of words that function as a single unit in a syntactic structure"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Constituent"@en .

omtd:Contradiction a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Contradiction"@en ;
    skos:broader omtd:DiscourseAnnotationType ;
    skos:definition "A set of statements that contradict each other (i.e. one of them asserts the truth and the other the falsity of the proposition)"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Contradiction"@en .

omtd:Date a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Date"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.ner.type.Date" ;
    skos:broader omtd:NamedEntity ;
    skos:definition "A text unit that denotes a date, a specific point in time"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Date"@en .

omtd:Dependency a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Dependency"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.syntax.type.dependency.Dependency" ;
    skos:broader omtd:SyntacticAnnotationType ;
    skos:definition "A type of syntactic relation that holds between linguistic units, where we try to recognise the head (governor) and its dependents"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Dependency"@en .

omtd:DependencyTree a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Dependency tree"@en ;
    skos:broader omtd:SyntacticAnnotationType ;
    skos:definition "A tree that represents the dependency relations in a sentence, i.e. showing the governor (head) and its dependents with directed links"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Dependency tree"@en .

omtd:DerivationalFeature a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Derivational feature"@en ;
    skos:broader omtd:MorphologicalAnnotationType ;
    skos:definition "Any feature relevant to the derivation process of a word (e.g. marking affixes, their meaning etc.)"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Derivational feature"@en .

omtd:DialogueAct a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Dialogue act"@en-gb,
        "Dialog act"@en-us ;
    skos:broader omtd:SpeechAct ;
    skos:definition "A dialogue act has two main components:  a communicative function and a semantic content. The semantic content specifies the objects, relations, actions, events, etc. that the dialogue act is about; the communicative function can be viewed as a specification of the way an addressee uses the semantic content to update his or her information state when  he  or  she  understands  the  corresponding  stretch  of dialogue. [http://www.lrec-conf.org/proceedings/lrec2010/pdf/560_Paper.pdf]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Dialogue act"@en-gb,
        "Dialog act"@en-us .

omtd:DiscourseRelation a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Discourse relation"@en ;
    skos:broader omtd:DiscourseAnnotationType ;
    skos:definition "The relation that holds between two segments of discourse; e.g. causal, temporal etc."@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Discourse relation"@en .

omtd:DocumentAnnotationType a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Document annotation type"@en ;
    skos:altLabel "Document information"@en,
        "Document metadata"@en ;
    skos:definition "Any kind of annotation that is used to describe a document (e.g. identifier, size, location, language etc.)"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Document annotation type"@en ;
    skos:topConceptOf omtd:AnnotationTypeScheme .

omtd:DocumentComparison a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Document comparison"@en ;
    rdfs:comment "The task/process of comparing different versions of the same document"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Document comparison"@en .

omtd:DocumentImageAnalysis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Document image analysis"@en ;
    rdfs:comment "The processing of images of documents in order to obtain a machine-readable description of the their contents and structure from the pixel data [adapted from https://www.ias.ac.in/article/fulltext/sadh/027/01/0003-0022]"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput,
        omtd:SupportOperation ;
    skos:definition "Document image analysis is the theory and practice of recovering the logical structure of digital images scanned from documents or produced by computer. It includes optical character recognition as one of its subfields, but has more ambitious tasks, both in the breadth (understand diagrams, music scores, images ...), and depth (e.g. the correct interpretation of a scanned mathematical formula)."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Document image analysis"@en .

omtd:Emotion a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Emotion"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "An affective state of consciousness in which joy, sorrow, fear, hate, or the like, is experienced, as distinguished from cognitive and volitional states of consciousness [http://www.dictionary.com/browse/emotion]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Emotion"@en .

omtd:EntityMentionPair a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Entity-Mention pair"@en ;
    skos:broader omtd:Coreference ;
    skos:definition "The pair of an entity and all the mentions of this entity formulated in various ways; used in co-reference resolution"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Entity-Mention pair"@en .

omtd:Event a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Event"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.ner.type.Event" ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "A thing that happens or takes place, especially one of importance [https://en.oxforddictionaries.com/definition/event]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Event"@en .

omtd:FacialExpression a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Facial expression"@en ;
    skos:broader omtd:ModalityAnnotationType ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Facial expression"@en .

omtd:FacialExpressionRecognition a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Facial expression recognition"@en ;
    rdfs:comment "The task/process of detecting emotions on human face based on biometric markers [adapted from https://sightcorp.com/knowledge-base/facial-expression-recognition/]"@en ;
    skos:altLabel "Expression detection"@en,
        "Expression recognition"@en,
        "Face expression detection"@en,
        "Face expression recognition"@en,
        "Facial expression detection"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Facial expression recognition"@en .

omtd:Facility a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Facility"@en ;
    skos:broader omtd:NamedEntity ;
    skos:definition "A human-made artifact in the domains of architecture and civil engineering [source: https://www.nltk.org/book/ch07.html]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Facility"@en .

omtd:Frequency a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Frequency"@en ;
    skos:broader omtd:QuantititativeInformation ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Frequency"@en .

omtd:GazeEyeMovement a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Gaze eye movement"@en ;
    skos:broader omtd:ModalityAnnotationType ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Gaze eye movement"@en .

omtd:Gene a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Gene"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "Specific sequence of nucleotides along a molecule of DNA (or, in the case of some viruses, RNA) which represents functional units of heredity [http://artemide.art.uniroma2.it:8081/agrovoc/agrovoc/en/page/c_3214]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Gene"@en .

omtd:GeneFamily a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Gene family"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "A gene family is a set of several similar genes, formed by duplication of a single original gene, and generally with similar biochemical functions [https://en.wikipedia.org/wiki/Gene_family]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Gene family"@en .

omtd:Geo-politicalEntity a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Geo-political entity"@en ;
    skos:altLabel "GPE"@en ;
    skos:broader omtd:NamedEntity ;
    skos:definition "A geographical area associated with some sort of political structure"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Geo-political entity"@en .

omtd:GrapeVariety a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Grape variety"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "A type of grape"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Grape variety"@en .

omtd:Habitat a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Habitat"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "The place or environment where an organism, plant or animal naturally or normally lives and grows"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Habitat"@en .

omtd:HandwritingRecognition a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Handwriting recognition"@en ;
    rdfs:comment "The ability of a computer to receive and interpret intelligible handwritten input from sources such as paper documents, photographs, touch-screens and other devices [from Wikipedia]"@en ;
    skos:altLabel "HWR"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput,
        omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Handwriting recognition"@en .

omtd:HeadMovement a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Head movement"@en ;
    skos:broader omtd:ModalityAnnotationType ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Head movement"@en .

omtd:HumanAidedMachineTranslation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Human Aided Machine Translation"@en ;
    rdfs:comment "The process of performing Machine Translation facilitated by pre-editing or post-editing steps, or interactive human intervention to steer or select from alternative translations"@en ;
    skos:altLabel "HAMT"@en ;
    skos:broader omtd:MachineTranslation ;
    skos:definition "We call Human-aided Machine Translation all systems and techniques which rely on real automation of the translation function when porting a text from one language to another. As opposed to full Machine Translation, human-aided MT does not fully rely on computational translation, but assists this process by pre-editing and post-editing steps, possibly also interactive human intervention to steer or select from alternative translations. Translation of real-time spoken language, by contrast, does not allow for human intervention, except for negotiation functions, such as clarification dialogues."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Human Aided Machine Translation"@en .

omtd:ImageUnderstanding a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Image Understanding"@en ;
    rdfs:comment "Advanced image processing in which artificial-intelligence techniques are used to interpret images by locating, characterizing, and recognizing objects and other features in the scene. [from https://www.encyclopedia.com/computing/dictionaries-thesauruses-pictures-and-press-releases/image-understanding]"@en,
        "Advanced image processing in which artificial-intelligence techniques are used to interpret images by locating, characterising, and recognising objects and other features in the scene. [from https://www.encyclopedia.com/computing/dictionaries-thesauruses-pictures-and-press-releases/image-understanding]"@en-gb ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput,
        omtd:TextAndDataMining ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Image Understanding"@en .

omtd:KnowledgeRepresentation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Knowledge Representation"@en ;
    rdfs:comment "",
        "The task/process of representing information about entities in a form that machines are capable of understanding it"@en ;
    skos:altLabel "KR"@en ;
    skos:broader omtd:TextAndDataMining ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Knowledge Representation"@en .

omtd:LanguageCode a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Language code"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Language code"@en ;
    skos:topConceptOf omtd:AnnotationTypeScheme .

omtd:LanguageIdentification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Language identification"@en ;
    rdfs:comment "The task/process of guessing what natural language a text or text segment is written in"@en ;
    skos:altLabel "Automatic Language Identification"@en,
        "Language recognition"@en ;
    skos:broader omtd:InformationExtraction,
        omtd:SupportOperation ;
    skos:definition "Automatic Language Identification (LID) is the process of identifying the natural language of a sample of speech or written text by an unknown speaker. Several important applications exist for LID, viz., as a front-end to, e.g., a call router in a telephone-based application or a multi-lingual speech recognition system."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Language identification"@en .

omtd:LanguageProficiencyLevel a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Language proficiency level"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Language proficiency level"@en ;
    skos:topConceptOf omtd:AnnotationTypeScheme .

omtd:LanguageTechnology a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Language Technology"@en ;
    rdfs:comment "Language technology, often called human language technology, studies methods of how computer programs or electronic devices can analyze, produce, modify or respond to human texts and speech. It consists of natural language processing and computational linguistics on the one hand, and speech technology on the other. [Wikipedia]"@en ;
    skos:altLabel "HLT"@en,
        "Human Language Technology"@en,
        "LT"@en ;
    skos:broader omtd:Operation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Language Technology"@en .

omtd:Lemma a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lemma"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.segmentation.type.Lemma" ;
    skos:broader omtd:MorphologicalAnnotationType ;
    skos:definition "The canonical or citation form used for referring to a word and its inflected forms"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Lemma"@en .

omtd:LexicalSemanticRelation a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexical semantic relation"@en ;
    skos:altLabel "Semantic relation"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "A relation holding between two or more words based on their meanings"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Lexical semantic relation"@en .

omtd:LinguisticEntity a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Linguistic entity"@en ;
    skos:broader omtd:DomainSpecificAnnotationType ;
    skos:definition "Any kind of annotation pertaining to entities of linguistics; the use of OLIA is recommended"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Linguistic entity"@en .

omtd:LipMovement a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lip movement"@en ;
    skos:broader omtd:ModalityAnnotationType ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Lip movement"@en .

omtd:Location a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Location"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.ner.type.Location" ;
    skos:broader omtd:NamedEntity ;
    skos:definition "A word or group of words that denotes a geographical entity"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Location"@en .

omtd:Marker a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Marker"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Marker"@en .

omtd:Miscellaneous a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Miscellaneous"@en ;
    skos:altLabel "MISC"@en ;
    skos:broader omtd:NamedEntity ;
    skos:definition "A general label for named entities other than the usual ones recognized by a system"@en,
        "A general label for named entities other than the usual ones recognised by a system"@en-gb ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Miscellaneous"@en .

omtd:MorphologicalFeature a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Morphological feature"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.lexmorph.type.morph.MorphologicalFeatures" ;
    skos:altLabel "Grammatical category"@en,
        "Grammatical feature"@en,
        "Morphosyntactic feature"@en ;
    skos:broader omtd:MorphologicalAnnotationType ;
    skos:definition "Property of a word that is expressed in its inflected form; examples include person, tense, gender, case etc."@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Morphological feature"@en .

omtd:MultiWordUnit a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Multi-word unit"@en ;
    skos:broader omtd:StructuralAnnotationType ;
    skos:definition "A combination of words that are considered as forming one semantic unit"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Multi-word unit"@en .

omtd:NeuroscienceEntity a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Neuroscience entity"@en ;
    skos:broader omtd:DomainSpecificAnnotationType ;
    skos:definition "Any kind of annotation pertaining to entities of neuroscience"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Neuroscience entity"@en .

omtd:OpticalCharacterRecognition a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Optical Character Recognition"@en ;
    rdfs:comment "The task/process of converting handwritten or printed material into machine editable text"@en ;
    skos:altLabel "OCR"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput,
        omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Optical Character Recognition"@en .

omtd:Organism a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Organism"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "An individual animal, plant, or single-celled life form [https://en.oxforddictionaries.com/definition/organism]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Organism"@en .

omtd:Organization a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Organization"@en,
        "Organisation"@en-gb ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.ner.type.Organization" ;
    skos:broader omtd:NamedEntity ;
    skos:definition "A word or group of words that denotes an organization, such as company, association, institution etc."@en,
        "A word or group of words that denotes an organisation, such as company, association, institution etc."@en-gb ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Organization"@en,
        "Organisation"@en-gb .

omtd:OrthographicTranscription1 a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Orthographic transcription"@en ;
    skos:broader omtd:Transcription1 ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Orthographic transcription"@en .

omtd:Paragraph a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Paragraph"@en ;
    skos:broader omtd:StructuralAnnotationType ;
    skos:definition "A division of a text, usually about a single theme, consisting of one or more sentences and marked by a new line, indentation or other conventions."@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Paragraph"@en .

omtd:PartOfSpeech a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Part of Speech"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.lexmorph.type.pos.POS" ;
    skos:altLabel "Grammatical category"@en,
        "Morphosyntactic category"@en,
        "Word category"@en ;
    skos:definition "A division of words based on common grammatical features"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Part of Speech"@en ;
    skos:topConceptOf omtd:AnnotationTypeScheme .

omtd:Person a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Person"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.ner.type.Person" ;
    skos:broader omtd:NamedEntity ;
    skos:definition "A word or group of words that refers to a person"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Person"@en .

omtd:PersuasiveExpression a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Persuasive expression"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "A word or phrase used for persuasion purposes"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Persuasive expression"@en .

omtd:Phenotype a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Phenotype"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "The physical appearance or biochemical characteristic of an organism as a result of the interaction of its genotype and the environment [http://www.biology-online.org/dictionary/Phenotype]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Phenotype"@en .

omtd:PhoneticTranscription1 a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Phonetic transcription"@en ;
    skos:broader omtd:Transcription1 ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Phonetic transcription"@en .

omtd:Phrase a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Phrase"@en ;
    skos:broader omtd:StructuralAnnotationType ;
    skos:definition "A phrase is a syntactic structure that consists of more than one word but lacks the subject-predicate organization of a clause. [http://www.glossary.sil.org/term/phrase]"@en,
        "A phrase is a syntactic structure that consists of more than one word but lacks the subject-predicate organisation of a clause. [http://www.glossary.sil.org/term/phrase]"@en-gb ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Phrase"@en .

omtd:PhysicoChemicalProperty a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Physico-chemical property"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "Physical and chemical property of substances"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Physico-chemical property"@en .

omtd:Polarity a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Polarity"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "A feature that distinguishes between positive, negative or neutral; in sentiment analysis, it refers to determining whether the expressed opinion in a document, a sentence or an entity feature/aspect is positive, negative, or neutral. [adapted from Wikipedia]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Polarity"@en .

omtd:ProsodicBoundary a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Prosodic boundary"@en ;
    skos:broader omtd:SpeechAnnotationType ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Prosodic boundary"@en .

omtd:ProsodicInformationProcessing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Prosodic information processing"@en ;
    skos:altLabel "Prosody information processing"@en ;
    skos:broader omtd:InformationExtraction,
        omtd:OperationWithMultimediaInputOrOutput ;
    skos:definition "Prosody can be defined as a feature of speech which extends over more than one segment and is often synonymous with 'suprasegmentals'. Prosodic features include fundamental frequency (F0),relative duration and intensity, and spectral quality. They determine the rhythm and intonation of utterances."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Prosodic information processing"@en .

omtd:ProteinFamily a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Protein family"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "A protein family is a group of proteins that share a common evolutionary origin, reflected by their related functions and similarities in sequence or structure [https://www.ebi.ac.uk/training/online/course/introduction-protein-classification-ebi/protein-classification/what-are-protein-families]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Protein family"@en .

omtd:Pseudonymization a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Pseudonymization"@en,
        "Pseudonymisation"@en-gb ;
    rdfs:comment "The processing of personal data in such a way that the data can no longer be attributed to a specific data subject without the use of additional information (from GDPR)"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Pseudonymization"@en,
        "Pseudonymisation"@en-gb .

omtd:QuestionTopicalTarget a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Question Topical Target"@en ;
    skos:altLabel "QTT"@en,
        "Question topic"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "The segment of a question that describes the entity about which the question is made"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Question Topical Target"@en .

omtd:Readability a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Readability"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.type.ReadabilityScore" ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "The ease with which a reader can understand a written text. [https://en.wikipedia.org/wiki/Readability]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Readability"@en .

omtd:Relation a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Relation"@en ;
    skos:broader omtd:DomainSpecificAnnotationType ;
    skos:definition "Any type of relation that holds between two or more entities of a specific domain"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Relation"@en .

omtd:Rna a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "RNA"@en ;
    skos:altLabel "Ribonucleic acid"@en ;
    skos:broader omtd:AgriculturalEntity ;
    skos:definition "Any of various nucleic acids that contain ribose and uracil as structural components and are associated with the control of cellular chemical activities"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "RNA"@en .

omtd:SemanticClass a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Semantic class"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.semantics.type.SemanticField" ;
    skos:altLabel "Semantic type"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "A division of words into classes based on their common semantic features"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Semantic class"@en .

omtd:SemanticFrame a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Semantic frame"@en ;
    dct:source <https://framenet.icsi.berkeley.edu/fndrupal/glossary> ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.semantics.type.SemanticPredicate" ;
    skos:altLabel "Frame"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "A schematic representation of a situation involving various participants, props and other conceptual roles, each of which is a frame element"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Semantic frame"@en .

omtd:SemanticRole a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Semantic role"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.semantics.type.SemanticArgument" ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "A semantic role is the underlying relationship that a participant has with the main verb in a clause [http://www.glossary.sil.org/term/semantic-role]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Semantic role"@en .

omtd:Sentence a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Sentence"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.segmentation.type.Sentence" ;
    skos:broader omtd:StructuralAnnotationType ;
    skos:definition "A group of words, usually containing a verb, that expresses a thought in the form of a statement, question, instruction, or exclamation and starts with a capital letter when written [https://dictionary.cambridge.org/dictionary/english/sentence]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Sentence"@en .

omtd:Sentiment a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Sentiment"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.sentiment.type.StanfordSentimentAnnotation" ;
    skos:altLabel "Opinion"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "The affective state (judgement, feeling) of a person or group towards an entity or event"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Sentiment"@en .

omtd:SentimentAnalysis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Sentiment analysis"@en ;
    rdfs:comment "The process/task of computationally identifying and categorizing opinions expressed in a piece of text, especially in order to determine whether the writer's attitude towards a particular topic, product, etc. is positive, negative, or neutral"@en,
        "The process/task of computationally identifying and categorising opinions expressed in a piece of text, especially in order to determine whether the writer's attitude towards a particular topic, product, etc. is positive, negative, or neutral"@en-gb ;
    skos:altLabel "Opinion extraction"@en,
        "Opinion mining"@en,
        "Polarity detection"@en,
        "Sentiment detection"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Sentiment analysis"@en .

omtd:SpectralData a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Spectral data"@en ;
    skos:broader omtd:NamedEntity ;
    skos:definition "Spectral data is essentially data derived by the use of spectroscopic instruments"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Spectral data"@en .

omtd:SpeechAssistedVideoControl a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech-assisted video control"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech-assisted video control"@en .

omtd:Stem a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Stem"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.segmentation.type.Stem" ;
    skos:broader omtd:MorphologicalAnnotationType ;
    skos:definition "A stem is the root or roots of a word, together with any derivational affixes, to which inflectional affixes are added. [http://www.glossary.sil.org/term/stem]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Stem"@en .

omtd:SubcategorizationFrame a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Subcategorization frame"@en,
        "Subcategorisation frame"@en-gb ;
    skos:altLabel "Argument structure"@en ;
    skos:broader omtd:SyntacticAnnotationType ;
    skos:definition "The number and types of syntactic arguments required by a certain lexical item (mainly verbs, but also nouns and adjectives)"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Subcategorization frame"@en,
        "Subcategorisation frame"@en-gb .

omtd:Subjectivity a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Subjectivity"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "The linguistic expression of somebody’s opinions, sentiments, emotions, evaluations, beliefs, speculations (private states, i.e. states that are not open to objective observation or verification). [http://www.mavir.net/docs/JWiebe-Subjectivity-nov2010.pdf]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Subjectivity"@en .

omtd:TalkingHeadSynthesis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Talking head synthesis"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Talking head synthesis"@en .

omtd:TemporalExpression a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Temporal expression"@en ;
    skos:broader omtd:SemanticAnnotationType ;
    skos:definition "A linguistic expression (word, group of words, group of numbers etc.) that denotes time (a point in time, duration, frequency)"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Temporal expression"@en .

omtd:Term a omtd:AnnotationType,
