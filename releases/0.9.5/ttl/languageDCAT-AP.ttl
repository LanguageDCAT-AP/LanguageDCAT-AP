    skos:altLabel "Computation of frequencies"@en ;
    skos:broader omtd:FeatureExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Frequency count"@en .

omtd:Funding a omtd:AnnotationType,
