    skos:broader omtd:SemanticAnnotationType ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Textual entailment"@en .

omtd:Token a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Token"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.segmentation.type.Token" ;
    skos:broader omtd:StructuralAnnotationType ;
    skos:definition "A set of characters surrounded by spaces or punctuation marks, as well as punctuation marks themselves"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Token"@en .

omtd:TopicDetection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Topic Detection"@en ;
    rdfs:comment "The task/process of identifying the topic of a text or dataset (e.g. by clustering keywords or using topic models)"@en ;
    skos:altLabel "TD"@en,
        "TDT"@en,
        "TT"@en,
        "Topic Detection and Tracking"@en,
        "Topic Tracking"@en,
        "Topic classification"@en,
        "Topic extraction"@en ;
    skos:broader omtd:InformationExtraction,
        omtd:KnowledgeDiscovery ;
    skos:definition "Topic Detection and Tracking (TDT) refers to automatic techniques for discovering, threading, and retrieving topically related material in streams of data."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Topic Detection"@en ;
    skos:related omtd:TextCategorization .

omtd:Transliteration a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Transliteration"@en ;
    rdfs:comment "Transliteration is the process of transferring a word from the alphabet of one language to another. [vocabulary.com]"@en ;
    skos:altLabel "Script conversion"@en ;
    skos:broader omtd:SpeechRecognition,
        omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Transliteration"@en .

omtd:VerbalAggressionTarget a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
