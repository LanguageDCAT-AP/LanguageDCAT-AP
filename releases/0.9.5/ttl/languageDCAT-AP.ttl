ms:LemmaType skos:exactMatch lexmeta:lemma ;
    skos:narrower lexmeta:variant .

ms:corpus1 a ms:LRType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "corpus"@en ;
    skos:definition "Value for 'LR type' for corpora, i.e. sets of datafiles (e.g., texts, audio recordings, videos, images, photographs, etc.)"@en ;
    skos:inScheme ms:LRTypeTaxonomy ;
    skos:prefLabel "corpus"@en ;
    skos:topConceptOf ms:LRTypeTaxonomy .

ms:wordNet a ms:LCRSubclass,
        ms:StandardBestPractice,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "WordNet"@en ;
    skos:definition "A lexical database originally created for English and extended to other languages, which groups words into sets of synonyms called synsets, provides short definitions and usage examples, and records a number of relations among these synonym sets or their members"@en ;
    skos:inScheme ms:LCRSubclassTaxonomy,
        ms:StandardBestPracticeTaxonomy ;
    skos:prefLabel "WordNet"@en ;
    skos:topConceptOf ms:LCRSubclassTaxonomy,
        ms:StandardBestPracticeTaxonomy .

omtd:AgeBracketDetection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Age-bracket detection"@en ;
    rdfs:comment "The task/process of identifying in a text a segment inside parentheses that describes an age group or age-related utterance"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Age-bracket detection"@en .

omtd:AnnotationOfCompounds a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of compounds"@en ;
    rdfs:comment "The task/process of marking compounds (single words composed of two or more free morphemes) and their parts"@en ;
    skos:broader omtd:MorphologicalAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of compounds"@en .

omtd:AnnotationOfDates a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of dates"@en ;
    rdfs:comment "The task/process of marking dates in a text"@en ;
    skos:altLabel "Date Detection"@en,
        "Date Recognition"@en ;
    skos:broader omtd:TemporalExpressionsLabelling ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of dates"@en .

omtd:AnnotationOfDerivationalFeatures a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of derivational features"@en ;
    rdfs:comment "The task/process of adding annotations relevant to the derivational level of analysis (e.g. recognizing derivational affixes, tagging their meaning etc.)"@en,
        "The task/process of adding annotations relevant to the derivational level of analysis (e.g. recognising derivational affixes, tagging their meaning etc.)"@en-gb ;
    skos:broader omtd:MorphologicalAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of derivational features"@en .

omtd:AnnotationOfDocumentStructure a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of document structure"@en ;
    rdfs:comment "The task/process of annotating the internal structure of a document (e.g. book chapters, sections in a journal article, title, preface, images/figures etc.)"@en ;
    skos:broader omtd:StructuralAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of document structure"@en .

omtd:AnnotationOfMeasurements a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of measurements"@en ;
    rdfs:comment "The task/process of annotating measurement expressions (e.g. of length, temperature, time, etc.)"@en ;
    skos:altLabel "Quantity detection"@en,
        "Quantity extraction"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of measurements"@en .

omtd:AnnotationOfMultiWordUnits a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of multi-word units"@en ;
    rdfs:comment "The task/process of annotating multi-word units, i.e. combinations of words that are considered as one"@en ;
    skos:broader omtd:MorphologicalAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of multi-word units"@en .

omtd:AnnotationOfNumbers a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of numbers"@en ;
    rdfs:comment "The task/process of annotating numbers in a text"@en ;
    skos:altLabel "Number detection"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of numbers"@en .

omtd:AnnotationOfQuestionTopics a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of question topics"@en ;
    rdfs:comment "The task/process of attaching tags to the segment of a question that functions as the topic of that question"@en ;
    skos:altLabel "Annotation of question topical targets"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of question topics"@en .

omtd:AnnotationOfSpeakerTurns a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of speaker turns"@en ;
    rdfs:comment "The task/process of marking locations in speech where there is a change of speakers"@en ;
    skos:broader omtd:SpeechAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of speaker turns"@en .

omtd:AnnotationOfTextualEntailment a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of textual entailment"@en ;
    rdfs:comment "The task/process of annotating textual entailments, most usually indicating whether a text entails or contradicts a hypothesis sentence or does neither"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of textual entailment"@en .

omtd:Argumentation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Annotation of argumentation"@en ;
    rdfs:comment "The task/process of marking argumentative structures, components and relations in a text"@en ;
    skos:broader omtd:DiscourseAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Annotation of argumentation"@en .

omtd:AudioClassification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Audio classification"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Audio classification"@en .

omtd:AudioProcessing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Audio processing"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Audio processing"@en .

omtd:AudioSegmentation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Audio segmentation"@en ;
    rdfs:comment "The task/process of partitioning audio stream into homogeneous segments and classifying them into speech and non-speech segments"@en ;
    skos:broader omtd:SpeechAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Audio segmentation"@en .

omtd:AutomaticHyperlinking a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Automatic hyperlinking"@en ;
    rdfs:comment "The identification of hyperlinkable entities (concepts, named entities) in a text and the assignment of hyperlinks (link targets) for each such entity"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:definition "Automatic hyperlinking is the insertion of hyperlinks into text documents by automatic means. The automatic hyperlinking process consists of the identification of hyperlinkable entities (concepts, named entities) in the original text, and the assignment of link targets for each such entity. Named entity recognition is often used for identifying linkable entities, for example geographical locations or organisation names. The assignment of link targets depends on a database with link targets for each entity. In general, there can be several link targets for each entity, for example for a company: its homepage, a map, a stock quote etc. Multiple outgoing hyperlinks from one target are supported by the W3C standard XLINK/XPointer. Automatic hyperlinking is an important technology for enabling the Semantic Web."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Automatic hyperlinking"@en .

omtd:AutomaticSubtitling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Automatic subtitling"@en ;
    rdfs:comment "The task/process of automatically adding subtitles to a video"@en ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Automatic subtitling"@en .

omtd:BiologicalActivity a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Biological activity"@en ;
    skos:broader omtd:BiologicalEnity,
        omtd:NamedEntity ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Biological activity"@en .

omtd:BiomedicalConceptNormalization a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Biomedical concept normalization"@en,
        "Biomedical concept normalisation"@en-gb ;
    rdfs:comment "The task of mapping free-form expressions to medical terms [source: Medical concept normalization in social media posts with recurrent neural networks]"@en ;
    skos:broader omtd:ConceptNormalization ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Biomedical concept normalization"@en,
        "Biomedical concept normalisation"@en-gb .

omtd:BotDetection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Bot detection"@en ;
    rdfs:comment "The task/process of identifying segments of text or speech discourse that have been uttered by bots"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Bot detection"@en .

omtd:BrainRegion a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Brain region"@en ;
    skos:broader omtd:BiologicalEnity,
        omtd:NamedEntity ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Brain region"@en .

omtd:CertaintyLevelLabelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Certainty level labelling"@en-gb,
        "Certainty level labeling"@en-us ;
    rdfs:comment "The task/process of adding to statements in a text annotations that indicate the level of certainty of the author vis-a-vis the statement"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Certainty level labelling"@en-gb,
        "Certainty level labeling"@en-us .

omtd:Chemical a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Chemical"@en ;
    skos:broader omtd:BiologicalEnity,
        omtd:NamedEntity ;
    skos:definition "Any substance (as an acid) that is formed when two or more other substances act upon one another or that is used to produce a change in another substance [https://www.merriam-webster.com/dictionary/chemical]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Chemical"@en .

omtd:Citation a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Citation"@en ;
    skos:broader omtd:ScholarlyAnalyticsEntity,
        omtd:ScholarlyCommunicationAnnotation ;
    skos:definition "Reference to a book, paper, or author, especially in a scholarly work."@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Citation"@en .

omtd:Conjugation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Conjugation"@en ;
    rdfs:comment "The act of generating (listing in a prescribed order) the various inflectional forms of a word"@en ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Conjugation"@en .

omtd:ContentMining a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Content Mining"@en ;
    rdfs:comment "The automated analysis of large volumes of content of any form or medium (e.g. text, images, videos, graphs, metadata etc.) that leads to the discovery of previously undiscovered information (e.g. identification of relationships between entities)"@en ;
    skos:broader omtd:Operation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Content Mining"@en ;
    skos:related omtd:TextAndDataMining .

omtd:ContradictionDetection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Contradiction detection"@en ;
    rdfs:comment "The task/process of identifying conflicting statements (contradictions) in a dataset"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Contradiction detection"@en .

omtd:ConversationalSystemsBuilding a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Conversational systems building"@en ;
    rdfs:comment "All activities related to the creation of conversational/dialogue systems (i.e. computer systems intended to converse with humans, through one or more communication modalities, such as text, speech, graphics, haptics, gestures)"@en ;
    skos:altLabel "Chatbots building"@en,
        "Conversational agents building"@en,
        "Dialogue systems building"@en,
        "Embodied agents building"@en,
        "Virtual agents building"@en ;
    skos:broader omtd:HumanComputerInteraction ;
    skos:editorialNote "I have put all terms together as alternative labels, but maybe they should be distinguished at a later stage"@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Conversational systems building"@en .

omtd:Coreference a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Coreference"@en ;
    skos:altLabel "Co-reference"@en ;
    skos:broader omtd:DiscourseAnnotationType ;
    skos:definition "Coreference is the reference in one expression to the same referent in another expression. [http://www.glossary.sil.org/term/coreference]"@en ;
    skos:editorialNote "As defined here it refers more to the phenomenon than the actual annotation types; referent and co-referent might be more appropriate"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:narrower omtd:EntityMentionPair ;
    skos:prefLabel "Coreference"@en .

omtd:CoreferenceAnnotation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Coreference annotation"@en ;
    rdfs:comment "The task/process of attaching tags to a text unit and linking it to other text units that refer to the same entity in the world"@en ;
    skos:altLabel "Co-reference annotation"@en,
        "Coreference identification"@en ;
    skos:broader omtd:DiscourseAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Coreference annotation"@en ;
    skos:related omtd:AnaphoraAnnotation .

omtd:CorpusViewing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Corpus viewing"@en ;
    rdfs:comment "The task/process of viewing the contents of a corpus as performed by human beings"@en ;
    skos:broader omtd:Viewing ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Corpus viewing"@en .

omtd:DataMasking a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Data masking"@en ;
    rdfs:comment "The process of hiding original data with modified content (characters or other data) in order to protect data classified as personal identifiable data, or sensitive data [adapted from Wikipedia]"@en ;
    skos:broader omtd:Anonymization ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Data masking"@en .

omtd:DataToTextGeneration a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Data to Text Generation"@en ;
    skos:broader omtd:TextGeneration ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Data to Text Generation"@en .

omtd:Debugging a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Debugging"@en ;
    rdfs:comment "The task/process of removing errors from a computer programme"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Debugging"@en .

omtd:DeepParsing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Deep parsing"@en ;
    rdfs:comment "The  task/process of building complete parse trees for a sentence [adapted from https://stackoverflow.com/questions/37020577/shallow-parsing-vs-deep-parsing-in-stanford-corenlp-java]"@en ;
    skos:broader omtd:Parsing ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Deep parsing"@en .

omtd:DependencyConversion a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Dependency conversion"@en ;
    rdfs:comment "The task/process of converting constituency structures to dependency trees"@en ;
    skos:broader omtd:FormatConversion ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Dependency conversion"@en ;
    skos:related omtd:ConstituencyParsing,
        omtd:DependencyParsing .

omtd:DerivationalAnalysis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Derivational analysis"@en ;
    rdfs:comment "The analysis of a word in order to identify its derivation, i.e. whether and how it has been formed on the basis of another word (e.g. through the use of affixes)"@en ;
    skos:broader omtd:LinguisticAnalysis ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Derivational analysis"@en .

omtd:DialogueModelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Dialogue modelling"@en ;
    rdfs:comment "The task/process of building models of dialogues to be used in dialogue systems"@en ;
    skos:altLabel "Dialog modeling"@en-us ;
    skos:broader omtd:LanguageModelling ;
    skos:definition "A Dialogue model is a system that simulates the behavior of dialogue participants. This includes formal models that instantiate linguistic theories of dialogue interaction and statistical models of dialogue behaviors."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Dialogue modelling"@en .

omtd:DiscourseAnalysis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Discourse analysis"@en ;
    rdfs:comment "A method of analysing the structure of texts or utterances longer than one sentence, taking into account both their linguistic content and their sociolinguistic context; analysis performed using this method.[OED, https://en.oxforddictionaries.com/definition/discourse_analysis]"@en ;
    skos:broader omtd:LinguisticAnalysis ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Discourse analysis"@en .

omtd:DiscourseModelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Discourse modelling"@en ;
    rdfs:comment "The task/process of building discourse models"@en ;
    skos:altLabel "Discourse modeling"@en-us ;
    skos:broader omtd:DiscourseAnnotation ;
    skos:definition "Discourse modelling describes all aspects of the relations between groups of sentences in monologue (text), dialogue, or multiparty interactions, e.g. text coherence, rhetorical relations, intentional and attentional state, centering, dialogue moves, dialogue acts, argument structures and reference phenomena, to name just a few. Recently, with the growing interest in multimodal discourse processing, discourse models extend their reach beyond the modality speech/language to other modalities like gesture, gaze or haptics, and cover also cross-modal phenomena."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Discourse modelling"@en .

omtd:EmotionDetection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Emotion recognition"@en ;
    rdfs:comment "The recognition of emotions from text, speech, facial expressions, gestures and/or physiological measures"@en ;
    skos:altLabel "Emotion detection"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:definition "The recognition of emotions from text, speech, facial expressions, gestures and/or physiological measures. A key challenge is the appropriate representation of emotional states."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Emotion recognition"@en .

omtd:EmotionGeneration a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Emotion generation"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Emotion generation"@en .

omtd:EmotionLabelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Emotion labelling"@en-gb,
        "Emotion labeling"@en-us ;
    rdfs:comment "The process/task of identifying types of feelings (e.g. anger, fear, happiness, sadness, etc.) in the linguistic expression of texts or facial expressions"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Emotion labelling"@en-gb,
        "Emotion labeling"@en-us .

omtd:EntityLinking a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Entity linking"@en ;
    rdfs:comment "The task/process of attaching tags to all the mentions of an entity in a text linking them together with the entity"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Entity linking"@en .

omtd:EntityMentionLabelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Entity mention labelling"@en-gb,
        "Entity mention labeling"@en-us ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Entity mention labelling"@en-gb,
        "Entity mention labeling"@en-us .

omtd:EntityMentionRecognition a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Entity mention recognition"@en ;
    rdfs:comment "The task/process of detecting in a text mentions of a specific class of entities (e.g. biochemical entities, historical persons)"@en ;
    skos:altLabel "Entity mention detection"@en,
        "Mention detection"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Entity mention recognition"@en ;
    skos:related omtd:NamedEntityRecognition .

omtd:EventDetection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Event detection"@en ;
    rdfs:comment "The process/task of identifying events in data (text, video, images etc.), usually combined with their classification into types of events and recognition of the event attributes (e.g. time, place, participants and duration)"@en ;
    skos:altLabel "Event extraction"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Event detection"@en .

omtd:EventLabelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Event labelling"@en-gb,
        "Event labeling"@en-us ;
    rdfs:comment "The process/act of marking events and classifying them into types of events in a text"@en ;
    skos:altLabel "Annotation of events"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Event labelling"@en-gb,
        "Event labeling"@en-us .

omtd:ExploratorySearch a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Exploratory search"@en ;
    rdfs:comment "A type of search which, in contrast to traditional lookup search, covers a broad class of activities, such as investigating, evaluating, comparing, and synthesizing"@en,
        "A type of search which, in contrast to traditional lookup search, covers a broad class of activities, such as investigating, evaluating, comparing, and synthesising"@en-gb ;
    skos:broader omtd:InformationRetrieval ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Exploratory search"@en .

omtd:ExtractionOfFundingInformation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Extraction of funding information"@en ;
    rdfs:comment "The task/process of detecting in a text and extracting information relevant to funding (e.g. funding programme, award, funder etc.)"@en ;
    skos:altLabel "Mining of funding information"@en ;
    skos:broader omtd:ExtractionOfDomainSpecificInformation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Extraction of funding information"@en .

omtd:ExtractionOfQuantitativeInformation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Extraction of quantitative information"@en ;
    rdfs:comment "The task of computing and extracting quantitative properties (e.g. of strings, words, etc.)"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Extraction of quantitative information"@en .

omtd:FaceDetection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Face detection"@en ;
    rdfs:comment "The task/process of recognizing that a person appears on a digital image or a video frame from a video source and possibly marking the contours around it"@en,
        "The task/process of recognising that a person appears on a digital image or a video frame from a video source and possibly marking the contours around it"@en-gb ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Face detection"@en .

omtd:FaceRecognition a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Face recognition"@en ;
    rdfs:comment "The task/process of identifying or verifying a person from a digital image or a video frame from a video source [adapted from Wikipedia]"@en ;
    skos:altLabel "Facial recognition"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Face recognition"@en .

omtd:FaceVerification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Face verification"@en ;
    rdfs:comment "The task/process of validating a claimed identity based on the image of a face, and either accepting or rejecting the identity claim [adapted from http://www.idiap.ch/~marcel/labs/faceverif.php]"@en ;
    skos:altLabel "Face authentication"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Face verification"@en .

omtd:FactChecking a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Fact checking"@en ;
    rdfs:comment "The act of checking factual assertions in non-fictional text in order to determine the veracity and correctness of the factual statements in the text [from Wikipedia]"@en ;
    skos:altLabel "Fact-checking"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Fact checking"@en ;
    skos:related omtd:FakeNewsDetection .

omtd:FillMask a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Fill mask"@en ;
    rdfs:comment "Masked Language Modeling is a fill-in-the-blank task, where a model uses the context words surrounding a mask token to try to predict what the masked word should be. [Source: https://keras.io/examples/nlp/masked_language_modeling/]" ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Fill mask"@en .

omtd:FlowControl a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Flow control"@en ;
    dct:source <https://en.wikipedia.org/wiki/Flow_control_(data)> ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Flow control"@en .

omtd:FrameExtraction a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Frame extraction"@en ;
    rdfs:comment "The task of recognizing words and phrases that evoke semantic frames as defined in the FrameNet project, and their semantic dependents"@en,
        "The task of recognising words and phrases that evoke semantic frames as defined in the FrameNet project, and their semantic dependents"@en-gb ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Frame extraction"@en .

omtd:FrequencyCount a omtd:Operation,
