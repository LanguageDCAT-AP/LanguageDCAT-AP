@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatlds: <http://w3id.org/lang-dcat-ap/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix it6: <http://data.europa.eu/it6/> .
@prefix lexbib: <https://lexbib.elex.is/entity/> .
@prefix lexmeta: <http://w3id.org/meta-share/lexmeta#> .
@prefix ms: <http://w3id.org/meta-share/meta-share/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix omtd: <http://w3id.org/meta-share/omtd-share/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wikidata: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cc:legalcode a owl:ObjectProperty ;
    rdfs:label "link to legal text"@en ;
    rdfs:comment "The URL of the legal text of a License."@en,
        "The URL of the legal text of a Licence."@en-gb ;
    rdfs:domain dct:LicenseDocument ;
    rdfs:range rdfs:Resource ;
    skos:note "Added as domain dct:LicenseDocument instead of cc:License (subclassOf dct:LicenseDocument)"@en .

it6:bias a owl:DatatypeProperty ;
    rdfs:label "bias"@en ;
    rdfs:comment "A description of the possible biases affecting the overall output of the model"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

it6:designSpecifications a owl:DatatypeProperty ;
    rdfs:label "design specifications"@en ;
    rdfs:comment "A general description of the main steps or stages involved in the training process, including training methodologies and techniques, the key design choices, assumptions made and what the model is designed to optimise for, and the relevance of different parameters, as applicable."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

it6:hasBenchmark a owl:ObjectProperty ;
    rdfs:label "has benchmark"@en ;
    rdfs:comment "The benchmarks used to evaluate this model."@en ;
    rdfs:range it6:Benchmark .

it6:hasInferencingImpact a owl:ObjectProperty ;
    rdfs:label "has inferencing impact"@en ;
    rdfs:comment "The impact of inferencing the model."@en ;
    rdfs:range it6:EnvironmentalImpact .

it6:hasInputModality a owl:ObjectProperty ;
    rdfs:label "has input modality"@en ;
    rdfs:comment "The modality of the input of the model."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range it6:Modality .

it6:hasOutputModality a owl:ObjectProperty ;
    rdfs:label "has output modality"@en ;
    rdfs:comment "The modality of the output of the model."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range it6:Modality .

it6:hasTrainingImpact a owl:ObjectProperty ;
    rdfs:label "has training impact"@en ;
    rdfs:comment "Measured or estimated amount of energy used for training."@en ;
    rdfs:range it6:EnvironmentalImpact .

it6:intendedUse a owl:DatatypeProperty ;
    rdfs:label "intended use"@en ;
    rdfs:comment "The prescribed application of the model."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

it6:limitations a owl:DatatypeProperty ;
    rdfs:label "limitations"@en ;
    rdfs:comment "The limited capabilities of the model"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

it6:measurementMethodology a owl:DatatypeProperty ;
    rdfs:label "measurement methodology"@en ;
    rdfs:comment "The methodology with which the resource was measured."@en ;
    rdfs:domain it6:EnvironmentalImpact ;
    rdfs:range rdf:langString .

it6:powerConsumption a owl:DatatypeProperty ;
    rdfs:label "power consumption"@en ;
    rdfs:comment "The consumed power."@en ;
    rdfs:domain it6:EnvironmentalImpact ;
    rdfs:range rdf:langString .

it6:releaseDate a owl:DatatypeProperty ;
    rdfs:label "release date"@en ;
    rdfs:comment "The date a model is released."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range xsd:date .

it6:trainedOn a owl:ObjectProperty ;
    rdfs:label "trained on"@en ;
    rdfs:comment "The training dataset used to train the machine learning model"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range ms:Corpus ;
    skos:note "Changed ms:MLModel as domain and ms:Corpus (subclass of dcat:Dataset) as range"@en .

it6:trainingMethodologies a owl:DatatypeProperty ;
    rdfs:label "training methodologies"@en ;
    rdfs:comment "A description of the methodologies used."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

it6:trainingProcess a owl:DatatypeProperty ;
    rdfs:label "training process"@en ;
    rdfs:comment "A description of the training process."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

dct:alternative a owl:DatatypeProperty ;
    rdfs:label "Alternative title"@en ;
    rdfs:comment "An alternative name for the resource."@en ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dct:title .

dct:conformsTo a owl:ObjectProperty ;
    rdfs:label "Conforms To"@en ;
    rdfs:range dct:Standard ;
    skos:comment "An established standard to which the described resource conforms."@en .

dct:created a owl:AnnotationProperty .

dct:creator a owl:ObjectProperty ;
    rdfs:label "Creator"@en ;
    rdfs:comment "An entity responsible for making the resource."@en ;
    rdfs:range foaf:Agent .

dct:description a owl:DatatypeProperty ;
    rdfs:label "Description"@en ;
    rdfs:comment "An account of the resource."@en ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf owl:topDataProperty .

dct:identifier a owl:DatatypeProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "An unambiguous reference to the resource within a given context."@en ;
    rdfs:range rdfs:Literal .

dct:issued a owl:AnnotationProperty .

dct:license a owl:ObjectProperty ;
    rdfs:label "License"@en,
        "Licence"@en-gb ;
    rdfs:comment "A legal document giving official permission to do something with the resource."@en ;
    rdfs:range dct:LicenseDocument .

dct:modified a owl:DatatypeProperty ;
    rdfs:label "Date Modified"@en ;
    dct:description "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en ;
    dct:issued "2000-07-11"^^xsd:date ;
    rdfs:comment "Date on which the resource was changed."@en ;
    rdfs:isDefinedBy dct: ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dct:date .

dct:publisher a owl:ObjectProperty ;
    rdfs:label "Publisher"@en ;
    rdfs:comment "An entity responsible for making the resource available."@en ;
    rdfs:range foaf:Agent ;
    skos:comment "[PL] in DCAT v3: foaf:Agent is recommended & in DC foaf:Agent is included in Range; I've added as range"@en .

dct:replaces a owl:AnnotationProperty .

dct:source a owl:AnnotationProperty .

dct:spatial a owl:ObjectProperty ;
    rdfs:label "Spatial coverage"@en ;
    rdfs:comment "Spatial characteristics of the resource"@en ;
    rdfs:range dct:Location .

dct:temporal a owl:ObjectProperty ;
    rdfs:label "Temporal coverage"@en ;
    rdfs:comment "Temporal characteristics of the resource"@en ;
    rdfs:range dct:PeriodOfTime .

schema1:rangeIncludes a owl:AnnotationProperty .

dcatlds: a owl:NamedIndividual ;
    dct:description "LanguageDCAT-AP is conceived and implemented as an extension of DCAT-AP (https://semiceu.github.io/DCAT-AP/releases/3.0.0/), an application profile for sharing information about Catalogues containing Datasets and Data Services descriptions in Europe, under maintenance by the SEMIC action, Interoperable Europe. LanguageDCAT-AP builds upon DCAT-AP and DCAT (https://www.w3.org/TR/vocab-dcat-3/) for generic classes and properties, combined with domain-specific vocabularies already used in the broader language data and services community, and more specifically, the META-SHARE ontology (http://w3id.org/meta-share/meta-share)."@en ;
    dct:title "LanguageDCAT-AP model"@en .

dcatlds:0.9.2 a ms:StandardBestPractice,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "LanguageDCAT-AP v0.9.2"@en ;
    rdfs:seeAlso "https://languagedcat-ap.github.io/LanguageDCAT-AP/releases/0.9.2/" ;
    skos:inScheme ms:StandardBestPracticeTaxonomy ;
    skos:prefLabel "LanguageDCAT-AP v0.9.2"@en ;
    skos:topConceptOf ms:StandardBestPracticeTaxonomy .

dcatlds:0.9.3 a ms:StandardBestPractice,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "LanguageDCAT-AP v0.9.3"@en ;
    rdfs:seeAlso "https://languagedcat-ap.github.io/LanguageDCAT-AP/releases/0.9.3/" ;
    skos:inScheme ms:StandardBestPracticeTaxonomy ;
    skos:prefLabel "LanguageDCAT-AP v0.9.3"@en ;
    skos:topConceptOf ms:StandardBestPracticeTaxonomy .

dcatlds:0.9.5 a ms:StandardBestPractice,
        owl:NamedIndividual,
        owl:Ontology,
        skos:Concept ;
    rdfs:label "LanguageDCAT-AP model v0.9.5"@en,
        "LanguageDCAT-AP v0.9.5"@en ;
    dct:created "2023-06-01" ;
    dct:issued "2026-05-16" ;
    dct:language "English"@en ;
    dct:title "LanguageDCAT-AP model v0.9.5"@en ;
    rdfs:comment "Based on DCAT-v3, DCAT-AP v3, MLDCAT-AP and MS-OWL v2"@en ;
    rdfs:seeAlso "https://languagedcat-ap.github.io/LanguageDCAT-AP/releases/0.9.5/" ;
    owl:versionInfo "0.9.5" ;
    skos:inScheme ms:StandardBestPracticeTaxonomy ;
    skos:prefLabel "LanguageDCAT-AP v0.9.5"@en ;
    skos:topConceptOf ms:StandardBestPracticeTaxonomy .

dcatlds:Evaluation a owl:Class ;
    rdfs:label "Evaluation"@en ;
    rdfs:comment "The evaluation used to assess the performance of a model"@en .

dcatlds:accessLevel a owl:DatatypeProperty ;
    rdfs:label "access level"@en ;
    rdfs:comment "The level of model access (e.g. weights-level access, black-box access)"@en ;
    rdfs:domain dcatlds:ModelDistribution ;
    rdfs:range rdf:langString .

dcatlds:amountOfActiveParameters a owl:DatatypeProperty ;
    rdfs:label "amount of active parameters"@en ;
    rdfs:comment "Specifies the number of active parameters"@en ;
    rdfs:domain dcatlds:ModelDistribution ;
    rdfs:range xsd:float .

dcatlds:broadInternalUse a dcatlds:ScopeOfUse,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "broad internal use"@en ;
    skos:definition "Internal Use of the Data by the Data Recipient and, in addition, by its affiliates, subsidiaries and other closely related entities, provided that: (i) each such entity is bound by confidentiality and use restrictions at least equivalent to those of the Agreement; and (ii) no further access, disclosure or use by unrelated third parties is permitted."@en ;
    skos:inScheme dcatlds:ScopeOfUseTaxonomy ;
    skos:prefLabel "broad internal use"@en .

dcatlds:derivativeTechnology a owl:NamedIndividual,
        odrl:Action ;
    rdfs:label "Distribution of derivative technology"@en ;
    rdfs:comment "Distribution of a technology (e.g., a language model) derived from the resource"@en ;
    odrl:includedIn cc:DerivativeWorks .

dcatlds:deriveData a owl:NamedIndividual,
        odrl:Action ;
    rdfs:label "Derive data"@en ;
    rdfs:comment "To create new data that are based upon, derived from, or incorporate the Data, where the original Data is modified, transformed, annotated, or processed to generate new insights or outputs, provided that such materials do not constitute a verbatim reproduction of the Data. Derived Data remains classified as Data under the Agreement and does not constitute a Product."@en ;
    odrl:includedIn odrl:derive .

dcatlds:developLLM a owl:NamedIndividual,
        odrl:Action ;
    rdfs:label "Develop LLM"@en ;
    rdfs:comment "To use the Data in order to design, build, train, test, validate, or improve a machine learning model only and no other technological products or services, whether intended for internal deployment or external release"@en ;
    odrl:includedIn odrl:derive .

dcatlds:developProducts a owl:NamedIndividual,
        odrl:Action ;
    rdfs:label "Develop products"@en ;
    rdfs:comment "To use the Data in order to design, build, train, test, validate, or improve a software application, algorithm, machine learning model, or other technological product or service, whether intended for internal deployment or external release; product development encompasses all stages of the lifecycle from prototyping to production deployment."@en ;
    odrl:includedIn odrl:derive .

dcatlds:developedProduct a owl:NamedIndividual,
        skos:Concept,
        odrl:LeftOperand ;
    rdfs:label "Developed product"@en ;
    rdfs:comment "Product (software application, algorithm, machine learning model, or other technological product or service) developed from using data"@en .

dcatlds:distributeDerivativeData a owl:NamedIndividual,
        odrl:Action ;
    rdfs:label "Public release of derivative data"@en ;
    rdfs:comment "To make the Derivative Data available to the general public or to a broad audience of third parties without restriction on who may access it, whether for free or for payment."@en ;
    odrl:includedIn cc:DerivativeWorks .

dcatlds:distributeDevelopedProducts a owl:NamedIndividual,
        odrl:Action ;
    rdfs:label "Public release of developed products"@en ;
    rdfs:comment "To release publicly products (software applications, algorithms, machine learning models, or other technological products or services) developed using the data"@en ;
    odrl:includedIn cc:DerivativeWorks .

dcatlds:distributionMethod a owl:DatatypeProperty ;
    rdfs:label "distribution method"@en ;
    rdfs:comment "A method of distribution for the model (e.g. enterprise, or subscription based access, access throug API, etc.)"@en ;
    rdfs:domain dcatlds:ModelDistribution ;
    rdfs:range rdf:langString .

dcatlds:evaluation a owl:ObjectProperty ;
    rdfs:label "evaluation"@en ;
    rdfs:comment "Groups information on the evaluation process performed"@en ;
    rdfs:range dcatlds:Evalution .

dcatlds:evaluationOutput a owl:DatatypeProperty ;
    rdfs:label "evaluation output"@en ;
    rdfs:comment "A description of the output results of an evaluation process."@en ;
    rdfs:range rdf:langString .

dcatlds:finetuningMethodology a owl:DatatypeProperty ;
    rdfs:label "finetuning methodology"@en ;
    rdfs:comment "The methodology used for finetuning the model"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

dcatlds:finetuningDescription a owl:DatatypeProperty ;
    rdfs:label "finetuning description"@en ;
    rdfs:comment "An account of the finetuning process including, for instance, training time, hyperparameters like learning rate, epochs, batch size, etc."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

dcatlds:format a owl:ObjectProperty ;
    rdfs:label "Format"@en ;
    rdfs:comment "The file format, physical medium, or dimensions of the resource."@en ;
    rdfs:range dct:MediaTypeOrExtent ;
    skos:note "Property equivalent to dct:format; introduced to maintain compatibility with DCAT-AP due to cardinality issues (DCAT-AP allows 0..1)" .

dcatlds:generationModel a owl:ObjectProperty ;
    rdfs:label "generation model"@en ;
    rdfs:comment "The model used to generate the synthetic output."@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:range ms:MLModel .

dcatlds:generationProcess a owl:DatatypeProperty ;
    rdfs:label "generation process"@en ;
    rdfs:comment "A description of the generation process used to produce the synthetic output."@en ;
    rdfs:range rdf:langString .

dcatlds:generationType a owl:ObjectProperty ;
    rdfs:label "generation type"@en ;
    rdfs:comment "Provenance type of the dataset (e.g., authentic, synthetic)."@en ;
    rdfs:range dcatlds:GenerationType .

dcatlds:inputLanguage a owl:ObjectProperty ;
    rdfs:label "input language"@en ;
    rdfs:comment "Specifies the language covered (understood) by a model, expressed according to the BCP47 recommendation"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range ms:Language ;
    rdfs:subPropertyOf dct:language .

dcatlds:instructions a owl:DatatypeProperty ;
    rdfs:label "instructions"@en ;
    rdfs:comment "Instructions on how to use the model"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

dcatlds:languageType a owl:ObjectProperty ;
    rdfs:label "language type"@en ;
    rdfs:comment "The type of language contents (e.g., written language, scripts, etc.)."@en ;
    rdfs:range dcatlds:LanguageType .

dcatlds:mediaType a owl:ObjectProperty ;
    rdfs:label "نوع الميديا"@ar,
        "typ média"@cs,
        "medietype"@da,
        "τύπος μέσου"@el,
        "media type"@en,
        "tipo de media"@es,
        "type de média"@fr,
        "tipo di media"@it,
        "メディア・タイプ"@ja ;
    rdfs:comment "The media type of the distribution as defined by IANA."@en ;
    rdfs:domain dcat:Distribution ;
    rdfs:range dct:MediaType ;
    rdfs:subPropertyOf dct:format ;
    skos:definition "The media type of the distribution as defined by IANA."@en ;
    skos:note "Property equivalent to dcat:mediaType; introduced to maintain compatibility with DCAT-AP due to cardinality differences (DCAT-AP allows only 0..1)"@en .

dcatlds:metric a owl:DatatypeProperty ;
    rdfs:label "metric"@en ;
    rdfs:comment "A description of the evaluation metric"@en ;
    rdfs:range rdf:langString .

dcatlds:modelDistribution a owl:ObjectProperty ;
    rdfs:label "model distribution"@en ;
    rdfs:comment "An available distribution of the model."@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range dcatlds:ModelDistribution .

dcatlds:nonCommercialUse a owl:NamedIndividual,
        odrl:Action ;
    rdfs:label "Non commercial use"@en ;
    rdfs:comment "To use the Data or Derivative Materials solely for purposes of academic research, education, personal study, or public-interest projects, where such use is not intended for, directed towards, or capable of generating direct or indirect commercial advantage, monetary compensation, or private financial gain. Cost recovery for administrative or technical services shall not, in itself, constitute Commercial Use, provided no profit margin is applied."@en ;
    skos:prefLabel "Non commercial use"@en ;
    odrl:includedIn odrl:use .

dcatlds:outputLanguage a owl:ObjectProperty ;
    rdfs:label "output language"@en ;
    rdfs:comment "Specifies the language output (generated) by a model, expressed according to the BCP47 recommendation"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range ms:Language ;
    rdfs:subPropertyOf dct:language .

dcatlds:participantLocation a owl:NamedIndividual,
        skos:Concept,
        odrl:LeftOperand ;
    rdfs:label "Participant's location"@en ;
    rdfs:comment "Geolocation restriction based on the participant's country of registration."@en ;
    skos:note "Value is retrieved by the DAPS token"@en .

dcatlds:seedDataset a owl:ObjectProperty ;
    rdfs:label "seed dataset"@en ;
    rdfs:comment "The organic dataset or collection from which the seed was drawn for the generation of synthetic datasets."@en ;
    rdfs:domain dcat:Dataset ;
    rdfs:range dcat:Dataset .

dcatlds:task a owl:DatatypeProperty ;
    rdfs:label "task"@en ;
    rdfs:comment "A description of the evaluation task"@en ;
    rdfs:range rdf:langString .

dcatlds:tokensPerParameter a owl:DatatypeProperty ;
    rdfs:label "tokens per parameter"@en ;
    rdfs:comment "Number of tokens per parameter"@en ;
    rdfs:domain dcatlds:ModelDistribution ;
    rdfs:range xsd:positiveInteger .

lexmeta:lexbibWikibaseEntity a owl:AnnotationProperty .

lexmeta:wikidataEntity a owl:AnnotationProperty .

ms:LanguageTaxonomy a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Language Taxonomy"@en ;
    rdfs:seeAlso "https://vocabularies.ilsp.gr/showvoc/#/datasets/Language_taxonomy/data" ;
    skos:prefLabel "Language Taxonomy"@en .

ms:LocationTaxonomy a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Location Taxonomy"@en ;
    rdfs:seeAlso "https://vocabularies.ilsp.gr/showvoc/#/datasets/Location_taxonomy/data" ;
    skos:prefLabel "Location Taxonomy"@en .

ms:NGramModel a owl:Class ;
    rdfs:label "N-gram model"@en ;
    rdfs:comment "A language model consisting of n-grams, i.e., specific sequences of a number of words"@en ;
    rdfs:subClassOf ms:MLModel .

ms:NeuralNetwork a owl:Class ;
    rdfs:label "Neural network"@en ;
    rdfs:comment "A set of algorithms, modeled loosely after the human brain, designed to recognize patterns [adapted from https://skymind.ai/wiki/neural-network]"@en,
        "A set of algorithms, modelled loosely after the human brain, designed to recognise patterns [adapted from https://skymind.ai/wiki/neural-network]"@en-gb ;
    rdfs:subClassOf ms:MLModel .

ms:ScriptTaxonomy a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Script Taxonomy"@en ;
    rdfs:seeAlso "https://vocabularies.ilsp.gr/showvoc/#/datasets/Script_taxonomy/data" ;
    skos:prefLabel "Script Taxonomy"@en .

ms:VariantTaxonomy a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Variant Taxonomy"@en ;
    rdfs:seeAlso "https://vocabularies.ilsp.gr/showvoc/#/datasets/Variant_taxonomy/data" ;
    skos:prefLabel "Variant Taxonomy"@en .

ms:WordEmbedding a owl:Class ;
    rdfs:label "Word embedding"@en ;
    rdfs:comment "Word embedding is the collective name for a set of language modeling and feature learning techniques in natural language processing where words or phrases from the vocabulary are mapped to vectors of real numbers. [wikipedia]"@en ;
    rdfs:subClassOf ms:MLModel .

ms:accessLocation a owl:DatatypeProperty ;
    rdfs:label "access location"@en ;
    rdfs:comment "A URL where the resource can be accessed from; it can be used for landing pages or for cases where the resource is accessible via an interface, i.e. cases where the resource itself is not provided with a direct link for downloading"@en ;
    rdfs:domain ms:SoftwareDistribution ;
    rdfs:range xsd:anyURI .

ms:amount a owl:DatatypeProperty ;
    rdfs:label "amount"@en ;
    rdfs:comment "Specifies the number of units that constitute anything that can be measured (e.g. size of a data resource or cost, etc.)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ms:Cost ms:Size ) ] ;
    rdfs:range xsd:float .

ms:annotationType a owl:ObjectProperty ;
    rdfs:label "annotation type"@en ;
    rdfs:comment "Specifies the annotation type of the annotated version(s) of a resource or the annotation type a tool/ service requires or produces as an output"@en ;
    rdfs:domain ms:Corpus ;
    rdfs:range omtd:AnnotationType .

ms:anonymizationDetails a owl:DatatypeProperty ;
    rdfs:label "anonymization details"@en,
        "anonymisation details"@en-gb ;
    rdfs:comment "If the resource has been anonymized, this field can be used for entering more information, e.g., tool or method used for the anonymization, by whom it has been performed, whether there was any check of the results, etc."@en,
        "If the resource has been anonymised, this field can be used for entering more information, e.g., tool or method used for the anonymisation, by whom it has been performed, whether there was any check of the results, etc."@en-gb ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range rdf:langString .

ms:anonymized a owl:ObjectProperty ;
    rdfs:label "anonymized"@en,
        "anonymised"@en-gb ;
    rdfs:comment "Indicates whether the language resource has been anonymized; anonymous data is information which does not relate to an identified or identifiable natural person or to personal data rendered anonymous in such a manner that the data subject is not or no longer identifiable"@en,
        "Indicates whether the language resource has been anonymised; anonymous data is information which does not relate to an identified or identifiable natural person or to personal data rendered anonymous in such a manner that the data subject is not or no longer identifiable"@en-gb ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range ms:Anonymized .

ms:citationText a owl:DatatypeProperty ;
    rdfs:label "citation text"@en ;
    rdfs:comment "The text with which a document or language resource can be cited (typically the full citation, incl. title, authors, publisher, etc.)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dcat:Resource foaf:Document ) ] ;
    rdfs:range rdf:langString .

ms:contextLength a owl:DatatypeProperty ;
    rdfs:label "context length"@en ;
    rdfs:comment "The maximum amount of text that an AI model can process and retain in memory at any given time"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range xsd:positiveInteger .

ms:corpusSubclass a owl:ObjectProperty ;
    rdfs:label "corpus subclass"@en ;
    rdfs:comment "Introduces a classification of corpora into types (used for descriptive reasons)"@en ;
    rdfs:domain ms:Corpus ;
    rdfs:range ms:CorpusSubclass .

ms:creationDetails a owl:DatatypeProperty ;
    rdfs:label "creation details"@en ;
    rdfs:comment "Provides additional information on the creation of a language resource"@en ;
    rdfs:domain ms:DataLanguageResource ;
    rdfs:range rdf:langString .

ms:dataProtectionPrincipleApplied a owl:ObjectProperty ;
    rdfs:label "applied data protection principle"@en ;
    rdfs:comment "Specifies the data protection principles that have been applied in compliance with the General Data Protection Regulation (Regulation (EU) 2016/679)"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range ms:DataProtectionPrinciple .

ms:deprecationDate a owl:DatatypeProperty ;
    rdfs:label "deprecation date"@en ;
    rdfs:comment "The date on which an entity was deprecated."@en ;
    rdfs:range xsd:date .

ms:domain a owl:ObjectProperty ;
    rdfs:label "domain"@en ;
    rdfs:comment "Identifies the domain according to which an entity is classified"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ms:Domain skos:Concept ) ] ;
    rdfs:subPropertyOf dcat:theme .

ms:downloadLocation a owl:DatatypeProperty ;
    rdfs:label "download location"@en ;
    rdfs:comment "A URL where the language resource (mainly data but also downloadable software programmes or forms) can be downloaded from"@en ;
    rdfs:domain ms:SoftwareDistribution ;
    rdfs:range xsd:anyURI .

ms:evaluationDataset a owl:ObjectProperty ;
    rdfs:label "evaluation dataset"@en ;
    rdfs:comment "The dataset used for the evaluation of the machine learning model"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range dcat:Dataset .

ms:evaluationResults a owl:DatatypeProperty ;
    rdfs:label "evaluation results"@en ;
    rdfs:comment "A description of the evaluation results against the evaluation dataset."@en ;
    rdfs:range rdf:langString .

ms:executionLocation a owl:DatatypeProperty ;
    rdfs:label "execution location"@en ;
    rdfs:comment "A URL where the resource (mainly software) can be directly executed"@en ;
    rdfs:domain ms:SoftwareDistribution ;
    rdfs:range xsd:anyURI .

ms:finetuneDataset a owl:ObjectProperty ;
    rdfs:label "dataset used in fine-tuning"@en ;
    rdfs:comment "The dataset used to fine-tune the machine learning model"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range dcat:Dataset .

dcatlds:baseModel a owl:ObjectProperty ;
    rdfs:label "base model"@en ;
    rdfs:comment "The model used to fine-tune the machine learning model"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range ms:MLModel .

ms:function a owl:ObjectProperty ;
    rdfs:label "function"@en ;
    rdfs:comment "Specifies the operation/function/task that a software object performs"@en ;
    rdfs:domain ms:ToolService ;
    rdfs:range omtd:Operation ;
    skos:altLabel "operation",
        "task" .

ms:hasIANASubtag a owl:DatatypeProperty ;
    rdfs:label "IANA subtag"@en ;
    rdfs:comment "Used in BCP47 recommendation for the subtag of a language, script, region or variant"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dct:Location ms:LanguageCode ms:Script ms:Variant ) ] ;
    rdfs:range xsd:string .

dcatlds:finetuningHardware a owl:DatatypeProperty ;
    rdfs:label "hardware used in finetuning"@en ;
    rdfs:comment "Description of the hardware used in the fine-tuning process"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range xsd:string .

ms:hasMacrolanguage a owl:ObjectProperty ;
    rdfs:label "has macrolanguage"@en ;
    rdfs:comment "Used for the macrolanguage of a language in the IANA subtag registry"@en ;
    rdfs:domain ms:LanguageCode ;
    rdfs:range ms:LanguageCode .

ms:hasOriginalSource a owl:ObjectProperty ;
    rdfs:label "has original source"@en ;
    rdfs:comment "Links a language resource to the original source that has been used for its creation, where it's derived or elicited from"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range ms:LanguageResource .

ms:hasPrefix a owl:DatatypeProperty ;
    rdfs:label "prefix"@en ;
    rdfs:comment "Used in BCP47 recommendation, to indicate which subtags are valid for a certain variant"@en ;
    rdfs:domain ms:Variant ;
    rdfs:range xsd:string .

ms:inputContentResource a owl:ObjectProperty ;
    rdfs:label "input content resource"@en ;
    rdfs:comment "Specifies the requirements set by a tool/service for the (content) resource that it processes"@en ;
    rdfs:domain ms:ToolService ;
    rdfs:range ms:ProcessingResource .

ms:iprHolder a owl:ObjectProperty ;
    rdfs:label "IPR holder"@en ;
    rdfs:comment "A person or an organization who holds the full Intellectual Property Rights (Copyright, trademark, etc.) that subsist in the resource. The IPR holder could be different from the creator that may have assigned the rights to the IPR holder (e.g., an author as a creator assigns her rights to the publisher who is the IPR holder) and the distributor that holds a specific licence (i.e. a permission) to distribute the work via a specific distributor."@en,
        "A person or an organisation who holds the full Intellectual Property Rights (Copyright, trademark, etc.) that subsist in the resource. The IPR holder could be different from the creator that may have assigned the rights to the IPR holder (e.g., an author as a creator assigns her rights to the publisher who is the IPR holder) and the distributor that holds a specific licence (i.e. a permission) to distribute the work via a specific distributor."@en-gb ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range foaf:Agent ;
    skos:altLabel "intellectual property rights holder"@en,
        "rights holder"@en .

ms:isDocumentedBy a owl:ObjectProperty ;
    rdfs:label "is documented by"@en ;
    rdfs:comment "Links a language resource to a document (e.g., research paper describing its contents or its use in a projemct, user manual, etc.) or any other form of documentation (e.g., a URL with support information) that is related to the resource"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range foaf:Document ;
    skos:altLabel "documentation report"@en .

ms:language a owl:ObjectProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "Specifies the language that is used in the resource or supported by the tool/service expressed according to the BCP47 recommendation"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range ms:Language ;
    rdfs:subPropertyOf dct:language .

ms:languageCode a owl:ObjectProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "Used to specify the first part of a language tag according to the BCP47 recommendation which indicates the language"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ms:Language ms:ProcessingResource ) ] ;
    rdfs:range ms:LanguageCode .

ms:languageDependent a owl:DatatypeProperty ;
    rdfs:label "language dependent"@en ;
    rdfs:comment "Indicates whether the operation of the tool or service is language dependent or not"@en ;
    rdfs:domain ms:ToolService ;
    rdfs:range xsd:boolean .

ms:languageScope a owl:ObjectProperty ;
    rdfs:label "scope"@en ;
    rdfs:comment "Used to indicate the scope of a language in the IANA subtag registry"@en ;
    rdfs:domain ms:LanguageCode ;
    rdfs:range ms:LanguageScope .

ms:languageTag a owl:DatatypeProperty ;
    rdfs:label "language tag"@en ;
    rdfs:comment "The identifier of a language, according to the IETF BCP47 guidelines"@en ;
    rdfs:domain ms:Language ;
    rdfs:range xsd:string .

ms:languageVarietyName a owl:DatatypeProperty ;
    rdfs:label "language variety name"@en ;
    rdfs:comment "A textual string used for referring to a language variety"@en ;
    rdfs:domain ms:Language ;
    rdfs:range rdf:langString .

ms:lcrSubclass a owl:ObjectProperty ;
    rdfs:label "LCR subclass"@en ;
    rdfs:comment "Introduces a classification of lexical/conceptual resources into types (used for descriptive reasons)"@en ;
    rdfs:domain ms:LexicalConceptualResource ;
    rdfs:range ms:LCRSubclass .

ms:lingualityType a owl:ObjectProperty ;
    rdfs:label "linguality type"@en ;
    rdfs:comment "Indicates whether the resource includes one, two or more languages"@en ;
    rdfs:domain ms:DataLanguageResource ;
    rdfs:range ms:LingualityType .

ms:linguisticInformation a owl:ObjectProperty ;
    rdfs:label "linguistic information"@en ;
    rdfs:comment "Provides a detailed account of the linguistic information contained in the lexical/conceptual resource"@en ;
    rdfs:domain ms:LexicalConceptualResource ;
    rdfs:range lexmeta:MicrostructureFeature .

ms:lrType a owl:ObjectProperty ;
    rdfs:label "language resource type"@en ;
    rdfs:comment "Specifies the type of a language resource"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range ms:LRType .

ms:mediaType a owl:ObjectProperty ;
    rdfs:label "media type"@en ;
    rdfs:comment "Specifies the modality type of a language resource or of the input/output of a language processing tool/service; each modality type is described through a distinctive set of technical features; a language resource may consist of different modality parts"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range ms:MediaType .

ms:metalanguage a owl:ObjectProperty ;
    rdfs:label "metalanguage"@en ;
    rdfs:comment "Specifies the language that is used as support for the resource (e.g., English for a grammar of French described in English or for a French dictionary with English definitions)"@en ;
    rdfs:domain ms:LexicalConceptualResource ;
    rdfs:range dct:LinguisticSystem ;
    rdfs:subPropertyOf dct:language .

ms:modelFunction a owl:ObjectProperty ;
    rdfs:label "model function"@en ;
    rdfs:comment "The function/task/operation a model performs"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range omtd:Operation .

ms:modelType a owl:ObjectProperty ;
    rdfs:label "model type"@en ;
    rdfs:comment "A classification of models based on their algorithm"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range ms:ModelType .

ms:multilingualityType a owl:ObjectProperty ;
    rdfs:label "multilinguality type"@en ;
    rdfs:comment "Indicates whether the resource (part) is parallel, comparable or mixed"@en ;
    rdfs:domain ms:DataLanguageResource ;
    rdfs:range ms:MultilingualityType .

ms:originalSourceDescription a owl:DatatypeProperty ;
    rdfs:label "original source description"@en ;
    rdfs:comment "A description in free text of the source material that has been used for the creation of a language data resource"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range rdf:langString .

ms:outputResource a owl:ObjectProperty ;
    rdfs:label "output resource"@en ;
    rdfs:comment "Specifies the output results of a tool/service, i.e. the features of the processed (content) resource"@en ;
    rdfs:domain ms:ToolService ;
    rdfs:range ms:ProcessingResource .

ms:parameterPrecision a owl:DatatypeProperty ;
    rdfs:label "parameter precision"@en ;
    rdfs:comment "The number of bits used to represent a model's parameters, which directly impacts the model's memory usage and computational efficiency"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range xsd:string .

ms:personalDataDetails a owl:DatatypeProperty ;
    rdfs:label "personal data details"@en ;
    rdfs:comment "If the resource includes personal data, this field can be used for entering more information, e.g., whether special handling of the resource is required (e.g., anonymization, further request for use, etc.)"@en,
        "If the resource includes personal data, this field can be used for entering more information, e.g., whether special handling of the resource is required (e.g., anonymisation, further request for use, etc.)"@en-gb ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range rdf:langString .

ms:personalDataIncluded a owl:ObjectProperty ;
    rdfs:label "personal data included"@en ;
    rdfs:comment "Specifies whether the language resource contains personal data, i.e., any information relating to an identified or identifiable natural person (data subject); an identifiable natural person is one who can be identified, directly or indirectly, in particular by reference to an identifier such as a name, an identification number, location data, an online identifier or to one or more factors specific to the physical, physiological, genetic, mental, economic, cultural or social identity of that natural person [Article 4(1) of the General Data Protection Regulation (Regulation (EU) 2016/679)]"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range ms:PersonalDataIncluded .

ms:pivotLanguage a owl:ObjectProperty ;
    rdfs:label "pivot language"@en ;
    rdfs:comment "The language acting as an intermediary for translations between many languages"@en ;
    rdfs:domain ms:DataLanguageResource ;
    rdfs:range dct:LinguisticSystem ;
    rdfs:subPropertyOf dct:language .

ms:processingResourceType a owl:ObjectProperty ;
    rdfs:label "processing resource type"@en ;
    rdfs:comment "Specifies the resource type that a tool/service takes as input or produces as output"@en ;
    rdfs:domain ms:ProcessingResource ;
    rdfs:range ms:ProcessingResourceType .

ms:quantizationProcess a owl:DatatypeProperty ;
    rdfs:label "quantization process"@en,
        "quantisation process"@en-gb ;
    rdfs:comment "The process used for the quantization"@en,
        "The process used for the quantisation"@en-gb ;
    rdfs:domain ms:MLModel ;
    rdfs:range rdf:langString .

ms:quantized a owl:DatatypeProperty ;
    rdfs:label "quantized"@en,
        "quantised"@en-gb ;
    rdfs:comment "Whether this version is quantized"@en,
        "Whether this version is quantised"@en-gb ;
    rdfs:domain ms:MLModel ;
    rdfs:range xsd:boolean .

ms:region a owl:ObjectProperty ;
    rdfs:label "region"@en ;
    rdfs:comment "Specifies the geographical region where a language is used according to the BCP47 recommendation"@en ;
    rdfs:domain ms:Language ;
    rdfs:range dct:Location .

ms:requiresSoftware a owl:DatatypeProperty ;
    rdfs:label "requires software"@en ;
    rdfs:comment "Specifies software tools or libraries that are required for the operation of a tool/service or model"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ms:LanguageDescription ms:ToolService ) ] ;
    rdfs:range xsd:string ;
    skos:note "left as a data property - it's for more general software than language processing tools, so difficult to restrict"@en .

ms:script a owl:ObjectProperty ;
    rdfs:label "script"@en ;
    rdfs:comment "Specifies the script used for writing a language"@en ;
    rdfs:domain ms:Language ;
    rdfs:range ms:Script .

ms:sensitiveDataDetails a owl:DatatypeProperty ;
    rdfs:label "special category data details"@en ;
    rdfs:comment "If the resource includes special category data, this field can be used for entering more information, e.g., whether special handling of the resource is required (e.g., anonymization, further request for use, etc.)"@en,
        "If the resource includes special category data, this field can be used for entering more information, e.g., whether special handling of the resource is required (e.g., anonymisation, further request for use, etc.)"@en-gb ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range rdf:langString .

ms:sensitiveDataIncluded a owl:ObjectProperty ;
    rdfs:label "special category data included"@en ;
    rdfs:comment "Specifies whether the language resource contains special category data, i.e., personal data revealing racial or ethnic origin, political opinions, religious or philosophical beliefs, or trade union membership, and the processing of genetic data, biometric data for the purpose of uniquely identifying a natural person, data concerning health or data concerning a natural person’s sex life or sexual orientation [Article 9(1) of the General Data Protection Regulation (Regulation (EU) 2016/679)]"@en ;
    rdfs:domain ms:LanguageResource ;
    rdfs:range ms:SensitiveDataIncluded .

ms:size a owl:ObjectProperty ;
    rdfs:label "size"@en ;
    rdfs:comment "Specifies the size of a countable entity with regard to the SizeUnit measurement in form of a number"@en ;
    rdfs:domain dcat:Distribution ;
    rdfs:range ms:Size .

ms:sizeUnit a owl:ObjectProperty ;
    rdfs:label "size unit"@en ;
    rdfs:comment "Specifies the unit that is used when providing information on the size of the resource or of resource parts"@en ;
    rdfs:domain ms:Size ;
    rdfs:range ms:SizeUnit .

ms:softwareDistribution a owl:ObjectProperty ;
    rdfs:label "software distribution"@en ;
    rdfs:comment "An available distribution of the service."@en ;
    rdfs:domain ms:ToolService ;
    rdfs:range ms:SoftwareDistribution .

ms:softwareDistributionForm a owl:ObjectProperty ;
    rdfs:label "software distribution form"@en ;
    rdfs:comment "A form of software"@en ;
    rdfs:domain ms:SoftwareDistribution ;
    rdfs:range ms:SoftwareDistributionForm .

ms:sourceLanguage a owl:ObjectProperty ;
    rdfs:label "source language"@en ;
    rdfs:comment "The language from which a translation is made."@en ;
    rdfs:domain ms:DataLanguageResource ;
    rdfs:range dct:LinguisticSystem ;
    rdfs:subPropertyOf dct:language .

ms:suppressScript a owl:ObjectProperty ;
    rdfs:label "suppress script"@en ;
    rdfs:comment "Used to indicate the script that can be suppressed for a certain language according to BCP47 recommendation"@en ;
    rdfs:domain ms:LanguageCode ;
    rdfs:range ms:Script .

ms:targetLanguage a owl:ObjectProperty ;
    rdfs:label "target language"@en ;
    rdfs:comment "The language into which a translation is made"@en ;
    rdfs:domain ms:DataLanguageResource ;
    rdfs:range dct:LinguisticSystem ;
    rdfs:subPropertyOf dct:language .

ms:url a owl:AnnotationProperty .

ms:variant a owl:ObjectProperty ;
    rdfs:label "variant"@en ;
    rdfs:comment "Specifies a variant for a language according to the BCP-47 recommendation"@en ;
    rdfs:domain ms:Language ;
    rdfs:range ms:Variant .

ms:variantOf a owl:ObjectProperty ;
    rdfs:label "variant of"@en ;
    rdfs:comment "The model on which this model has been based on or derived from or is a variation of"@en ;
    rdfs:domain ms:MLModel ;
    rdfs:range ms:MLModel ;
    skos:note "Could add as reverse property to it6:hasVariation"@en .

omtd:ArgumentMining a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Argument mining"@en ;
    rdfs:comment "The automatic extraction and identification of argumentative structures from natural language text"@en ;
    skos:altLabel "Argumentation mining"@en ;
    skos:broader omtd:ComputationalArgumentation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Argument mining"@en .

omtd:AudioToTextGeneration a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Audio to Text Generation"@en ;
    skos:broader omtd:TextGeneration ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Audio to Text Generation"@en .

omtd:ComponentTypeScheme a owl:NamedIndividual .

omtd:Concordancing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Concordancing"@en ;
    rdfs:comment "The automatic generation of concordances, i.e. formatted displays of all the occurrences of a particular types in a corpus"@en ;
    skos:broader omtd:Reading ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Concordancing"@en .

omtd:DataFormat a owl:Class ;
    rdfs:label "Data format"@en ;
    rdfs:comment "The format of a computer file storing data"@en ;
    rdfs:subClassOf dct:MediaType ;
    skos:altLabel "Data type"@en,
        "File format"@en .

omtd:DataFormatScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Data Format Taxonomy"@en ;
    rdfs:seeAlso "https://vocabularies.ilsp.gr/showvoc/#/datasets/Data_Format_Taxonomy/data" ;
    skos:prefLabel "Data Format Taxonomy"@en .

