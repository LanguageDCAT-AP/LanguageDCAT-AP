omtd:Evaluation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Evaluation"@en ;
    rdfs:comment "The task/process of assessing the quality of a resource, e.g. based on the contents (for a dataset) or performance (for a tool or service)"@en ;
    skos:broader omtd:Operation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:DeepParserPerformanceEvaluation,
        omtd:EvaluationOfBroadCoverageNaturalLanguageParsers,
        omtd:EvaluationOfMachineTranslationAndTranslationTools,
        omtd:SpeechSynthesisEvaluation,
        omtd:TaskOrientedTextAnalysisEvaluation ;
    skos:prefLabel "Evaluation"@en .

omtd:KnowledgeDiscovery a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Knowledge Discovery"@en ;
    rdfs:comment "The task/process of automatically searching large volumes of data for patterns that can be considered knowledge about the data"@en ;
    skos:altLabel "KD"@en,
        "KDD"@en,
        "Knowledge Discovery in Databases"@en ;
    skos:broader omtd:TextAndDataMining ;
    skos:definition "Generally, knowledge discovery / data mining is the process of analyzing data from different perspectives and summarizing it into useful information - information that can be used to increase revenue, cuts costs, or both. Data mining software is one of a number of analytical tools for analyzing data. It allows users to analyze data from many different dimensions or angles, categorize it, and summarize the relationships identified. Technically, data mining is the process of finding correlations or patterns among dozens of fields in large relational databases."@en,
        "Generally, knowledge discovery / data mining is the process of analyzing data from different perspectives and summarising it into useful information - information that can be used to increase revenue, cuts costs, or both. Data mining software is one of a number of analytical tools for analysing data. It allows users to analyse data from many different dimensions or angles, categorise it, and summarise the relationships identified. Technically, data mining is the process of finding correlations or patterns among dozens of fields in large relational databases."@en-gb ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:QuestionAnswering,
        omtd:RecognizingTextualEntailment ;
    skos:prefLabel "Knowledge Discovery"@en .

omtd:LanguageModelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Language Modelling"@en ;
    rdfs:comment "The construction of statistical or Machine Learning language models"@en ;
    skos:altLabel "LM"@en,
        "Language Modeling"@en ;
    skos:broader omtd:SupportOperation ;
    skos:definition "A Statistical Language Models predicts a word given a sequence of already known words (i.e. the history). Ist can also be applied to other sequences of symbols (e.g. DNA). Very often the history contains just the previous two words. This is called a trigram. The parameters of statistical language models are estimated from a set of training examples. Data sparsity and smoothing of the estimates is one of the core problems. The best smoothing technique known so far is Kneser-Ney-Smoothing. Maximum-Entropy techniques are also under investigation and may be the method of choice for long-range language models (beyond trigram). Language models are used in text-compression, speech recognition, information retrieval and information extraction."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:DialogueModelling,
        omtd:StatisticalLanguageModelling,
        omtd:TrainingOfLanguageModels,
        omtd:TrainingOfMachineLearningModels,
        omtd:TrainingOfNmtModels ;
    skos:prefLabel "Language Modelling"@en .

omtd:MorphologicalAnnotationType a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Morphological annotation type"@en ;
    skos:definition "Any type of annotation pertaining to the morphological level"@en ;
