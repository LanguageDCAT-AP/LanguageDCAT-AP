    skos:broader omtd:AnnotationFormat,
        omtd:Xml ;
    skos:definition "Format for annotations of video files with the ELAN annotator"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "EUDICO annotation format"@en .

omtd:Emma a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "EMMA"@en ;
    skos:broader omtd:AnnotationFormat,
        omtd:Xml ;
    skos:definition "Data format according to the EMMA (Extensible MultiModal Annotation markup language) specifications, cf. https://www.w3.org/TR/2007/CR-emma-20071211/"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "EMMA"@en .

omtd:Folia a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "FoLiA"@en ;
    rdfs:seeAlso "https://proycon.github.io/folia/" ;
    skos:altLabel "Format for Linguistic Annotation"@en ;
    skos:broader omtd:AnnotationFormat,
        omtd:Xml ;
    skos:definition "FoLiA is an XML-based annotation format, suitable for the representation of linguistically annotated language resources"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "FoLiA"@en .

omtd:GateXml a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "GATE XML"@en ;
    skos:broader omtd:GateFormat,
        omtd:Xml ;
    skos:definition "XML-based format for GATE components"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "GATE XML"@en .

omtd:ImageFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Image format"@en ;
    skos:definition "Any format used for image files"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:svg ;
    skos:prefLabel "Image format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

omtd:Imscwb a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "imsCwb"@en ;
    omtd:hasMimetype "text/x.org.dkpro.imscwb" ;
    rdfs:seeAlso "https://dkpro.github.io/dkpro-core/releases/1.8.0/docs/format-reference.html#format-de.tudarmstadt.ukp.dkpro.core.io.imscwb-asl" ;
    skos:altLabel "IMS Corpus Workbench"@en ;
    skos:broader omtd:CorpusFormat,
        omtd:TabularFormat ;
    skos:definition "A tab-separated format with limited markup (e.g. for sentences, documents, but not recursive structures like parse-trees) used by the IMS Open Corpus Workbench."@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "imsCwb"@en .

omtd:InlineXml a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Inline XML"@en ;
    rdfs:seeAlso "https://dkpro.github.io/dkpro-core/releases/1.8.0/docs/format-reference.html#format-de.tudarmstadt.ukp.dkpro.core.io.xml-asl" ;
    skos:broader omtd:AnnotationFormat,
        omtd:Xml ;
    skos:definition "Inline XML file format"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "Inline XML"@en .

omtd:OpenFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Open format"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:OpenOfficeDocument ;
    skos:prefLabel "Open format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

omtd:PackageFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Package format"@en ;
    skos:definition "The package format of the distribution in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together."@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:Tgz ;
    skos:prefLabel "Package format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

omtd:Pls a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "PLS"@en ;
    rdfs:seeAlso "https://www.iana.org/assignments/media-types/application/pls+xml" ;
    skos:broader omtd:DocumentFormat,
        omtd:Xml ;
    skos:definition "Data format according to the Pronunciation Lexicon Specification (PLS)"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "PLS"@en .

omtd:Pml a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "PML"@en ;
    omtd:hasMimetype "application/x-SDL-TM" ;
    rdfs:seeAlso "http://ufal.mff.cuni.cz/jazz/PML/index_en.html",
        "https://builds.openminted.eu/job/WP%205.2%20-%20Typesystem%20alignment/eu.openminted.interop$mapping-conversion/doclinks/1/components.html#_prague_markup_language_1" ;
    skos:altLabel "Prague Markup Language"@en ;
    skos:broader omtd:AnnotationFormat,
        omtd:Xml ;
    skos:definition "Format according to the Prague Markup Language (http://ufal.mff.cuni.cz/jazz/PML/index_en.html) ; PML is a generic data format based on XML intended for storing linguistically annotated data, such as the Prague Dependency Treebank, also annotation lexicons, etc."@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "PML"@en .

omtd:Tei a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "TEI"@en ;
    rdfs:seeAlso "http://www.tei-c.org/index.xml",
        "https://www.iana.org/assignments/media-types/application/tei+xml" ;
    skos:altLabel "Text Encoding Initiative"@en ;
    skos:broader omtd:AnnotationFormat,
        omtd:Xml ;
    skos:definition "Data format for TEI-encoded (Text Encoding Initiative) texts"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "TEI"@en .

omtd:TextXML a dct:MediaType,
        omtd:DataFormat,
