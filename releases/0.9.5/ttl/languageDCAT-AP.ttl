    skos:inScheme lexmeta:MicrostructureFeatureScheme ;
    skos:narrower lexmeta:hyphenation,
        lexmeta:syllabification ;
    skos:prefLabel "divisió de mots"@ca,
        "orddeling"@da,
        "Worttrennung"@de,
        "word division"@en,
        "división de palabras"@es,
        "poolitamine"@et,
        "hitz banaketa"@eu,
        "orðskipting"@is,
        "divisione di parole"@it,
        "žodžių kėlimas"@lt,
        "împărțirea în silabe"@ro,
        "подела речи"@sr .

ms:Corpus a owl:Class ;
    rdfs:label "Corpus"@en ;
    rdfs:comment "A structured collection of pieces of data (textual, audio, video, multimodal/multimedia, etc.) typically of considerable size and selected according to criteria external to the data (e.g., size, type of language, type of text producers or expected audience, etc.) to represent as comprehensively as possible the object of study"@en ;
    rdfs:subClassOf ms:DataLanguageResource .

ms:LexicalConceptualResource a owl:Class ;
    rdfs:label "Lexical/Conceptual resource"@en ;
    rdfs:comment "A resource organised on the basis of lexical or conceptual entries (lexical items, terms, concepts, etc.) with their supplementary information (e.g., grammatical, semantic, statistical information, etc.)"@en ;
    rdfs:subClassOf ms:DataLanguageResource .

ms:Script a owl:Class ;
    rdfs:label "Script"@en ;
    rdfs:comment "The alphabet (set of letters or characters in which a certain language is written) in compliance with the BCP47 recommendation"@en .

ms:Size a owl:Class ;
    rdfs:label "Size"@en ;
    rdfs:comment "The size of the resource with regard to the SizeUnit measurement in form of a number"@en .

ms:Variant a owl:Class ;
    rdfs:label "Variant"@en ;
    rdfs:comment "The variant for a language according to the BCP47 recommendation"@en .

ms:recurrentNeuralNetwork a ms:ModelType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "recurrent neural network"@en ;
    skos:altLabel "RNN"@en ;
    skos:broader ms:DeepLearningModel ;
    skos:inScheme ms:ModelTypeTaxonomy ;
    skos:narrower ms:gatedRecurrentUnits,
        ms:longShortTermMemory ;
    skos:prefLabel "recurrent neural network"@en .

omtd:AnaphoraAnnotation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Anaphora annotation"@en ;
    rdfs:comment "The process/task of marking all linguistic expressions that appear in a certain text or across texts as referring to the same entity and linking it to this entity"@en ;
    skos:broader omtd:DiscourseAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Anaphora annotation"@en ;
    skos:related omtd:CoReferenceAnnotation .

omtd:AnaphoraResolution a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Anaphora resolution"@en ;
    rdfs:comment "The process/task of identifying all linguistic expressions that appear in a certain text or across texts and refer to the same entity"@en ;
    skos:broader omtd:LinguisticAnalysis ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Anaphora resolution"@en ;
    skos:related omtd:CoReferenceResolution .

omtd:Anonymization a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Anonymization"@en,
        "Anonymisation"@en-gb ;
    rdfs:comment "The task/process through which particular text segments or data units that allow the identification of a person are removed or replaced"@en ;
    skos:broader omtd:Annotation,
        omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:DataMasking,
        omtd:TextEncryption ;
    skos:prefLabel "Anonymization"@en,
        "Anonymisation"@en-gb .

omtd:AuthorClassification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Author classification"@en ;
    rdfs:comment "The task/process of organizing documents into groups/classes on the basis of their author"@en,
        "The task/process of organising documents into groups/classes on the basis of their author"@en-gb ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Author classification"@en .

omtd:AvatarSynthesis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Avatar synthesis"@en ;
    skos:broader omtd:HumanComputerInteraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Avatar synthesis"@en .

omtd:BelowPosTagging a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Below Part-of-Speech Tagging"@en ;
    rdfs:comment "The annotation of words with morphological information besides the part of speech and dependent upon it (e.g. for nouns: gender, number and case; for verbs: tense, number, person etc.)"@en ;
    owl:deprecated true ;
    skos:altLabel "Annotation of morphological features"@en,
        "B-PoS Tagging"@en,
        "Below PoS Tagging"@en ;
    skos:broader omtd:MorphologicalAnnotation,
        omtd:MorphosyntacticTagging ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Below Part-of-Speech Tagging"@en .

omtd:BuildingOfFiniteStateAutomata a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Building of finite state automata"@en ;
    rdfs:comment "The task/process of creating Finite State Automata (a mathematical model of computation)"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Building of finite state automata"@en ;
    skos:related omtd:FiniteStateTechnology .

omtd:Chunking a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Chunking"@en ;
    rdfs:comment "The task/process of dividing a sentence into chunks (non-overlapping text segments consisting of a head and preceding function words and/or modifiers)"@en ;
    skos:altLabel "Light parsing"@en,
        "Shallow Parsing"@en ;
    skos:broader omtd:Parsing ;
    skos:definition "Shallow parsing refers to a class of techniques for identifying phrasal chunks in texts without assigning deep hierarchical structures. Cascaded finite-state models are often used for shallow parsing. Shallow parsing techniques are used because they are more time-efficient and more error-tolerant than \"\"deep\"\" parsers, and give rise to fewer ambiguities."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:NounPhraseChunking ;
    skos:prefLabel "Chunking"@en .

omtd:CommentFiltering a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Comment filtering"@en ;
    rdfs:comment "The identification and removal of abusive, bullying, etc. comments from texts"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Comment filtering"@en .

omtd:ComputationalArgumentation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Computational argumentation"@en ;
    rdfs:comment "The process/task of identifying and representing argumentation in text, so that systems have the ability to use them in tasks, such as automated logical reasoning"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower <http://w3id.org/w3id.org/meta-share/omtd-share/ArgumentMining> ;
    skos:prefLabel "Computational argumentation"@en .

omtd:ConceptNormalization a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Concept normalization"@en,
        "Concept normalisation"@en-gb ;
    rdfs:comment "The task of mapping free-form expressions to the concepts of a specific domain"@en ;
    skos:broader omtd:Normalization ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:BiomedicalConceptNormalization ;
    skos:prefLabel "Concept normalization"@en,
        "Concept normalisation"@en-gb .

omtd:ConstituencyParsing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Constituency parsing"@en ;
    rdfs:comment "The task/process of identifying and marking constituents (phrases, governed by a head and including function words and/or modifiers ) in a text or text segment"@en ;
    skos:altLabel "Natural Language Parsing"@en,
        "Phrase parsing"@en ;
    skos:broader omtd:Parsing ;
    skos:definition "Parsing (from Latin \"\"pars orationis\"\" = parts of speech) is the syntactic analysis of languages. Natural Language Parsing is the syntactic analysis of natural languages, such as Finnish or Chinese. The objective of Natural Language Parsing is to determine parts of sentences (such as verbs, noun phrases, or relative clauses), and the relationships between them (such as subject or object). Unlike parsing of formally defined artificial languages (such as Java or predicate logic), parsing of natural languages presents problems due to ambiguity, and the productive and creative use of language."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Constituency parsing"@en .

omtd:CorpusManagement a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Corpus management"@en ;
    rdfs:comment "The task/process of managing corpora, e.g. creating, viewing, etc. through an integrated environment"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:ManagementOfAnnotations ;
    skos:prefLabel "Corpus management"@en .

omtd:Crawling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Web crawling"@en ;
    rdfs:comment "",
        "The use of bots that crawl the web (crawlers) in order to spot content that matches user-set criteria and download them to create large datasets"@en ;
    skos:altLabel "Crawling"@en,
        "Web Crawling and Spidering"@en ;
    skos:broader omtd:DataCollection ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Web crawling"@en .

omtd:DataMerging a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Data merging"@en ;
    rdfs:comment "The task/process of merging (combining) together data from various sources"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Data merging"@en .

omtd:DataSplitting a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Data splitting"@en ;
    rdfs:comment "The task/process of splitting (partitioning) available data into parts, usually for cross-validatory purposes, e.g. in order to use one part for training purposes and the other for evaluation"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Data splitting"@en .

omtd:DeepParserPerformanceEvaluation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Deep parser performance evaluation"@en ;
    rdfs:comment "The task/process of measuring the speed and accuracy of deep parsers with respect to a manually parsed test corpus"@en ;
    skos:broader omtd:Evaluation ;
    skos:definition "The task of parser evaluation is to measure the speed and accuracy of parsers with respect to a manually parsed test corpus. In the evaluation of so-called deep parsers, which are based on comprehensive linguistic theories, the assignment of the correct semantic analysis plays an important role. Another aspect is the handling and reduction of ambiguities, which is important not only from the linguistic point of view but because it plays a major role in the time and memory requirements of deep parsers. Test data can either be a treebank constructed from naturally occurring data, such as the \"\"Wall Street Corpus\"\", or a \"\"test suite\"\" containing constructed examples which cover all interesting linguistic phenomena. An important issue in deep parser evaluation is the comparison of parsers and grammars based on different linguistic theories."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Deep parser performance evaluation"@en .

omtd:DependencyParsing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Dependency parsing"@en ;
    dct:source "adapted from https://nlp.stanford.edu/software/nndep.shtml"@en ;
    rdfs:comment "The task/process of identifying and marking the grammatical structure of a sentence, establishing relationships between \"\"head\"\" words and words that modify those heads"@en ;
    skos:broader omtd:Parsing ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Dependency parsing"@en .

omtd:DocumentReading a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Document reading"@en ;
    rdfs:comment "The task/process of converting the contents of a digital document into speech in order to aid mainly individuals with visual impairments"@en ;
    skos:broader omtd:TextToSpeechSynthesis ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Document reading"@en .

omtd:DocumentSection a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Document section"@en ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/typesystem-reference.html#de.tudarmstadt.ukp.dkpro.core.api.segmentation.type.Div" ;
    skos:broader omtd:ScholarlyAnalyticsEntity,
        omtd:ScholarlyCommunicationAnnotation,
        omtd:StructuralAnnotationType ;
    skos:definition "Any subdivision of a document, e.g. a chapter, abstract, etc."@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Document section"@en .

omtd:Editing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Editing"@en ;
    rdfs:comment "The task/process of changing the contents of a resource"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Editing"@en .

omtd:EvaluationOfBroadCoverageNaturalLanguageParsers a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Evaluation of broad-coverage natural language parsers"@en ;
    rdfs:comment "The task/process of assessing the quality performance of parsers"@en ;
    skos:broader omtd:Evaluation ;
    skos:definition "The taks of parser evaluation is the measure the speed and accuracy of (symbolic or stochastic) parsers with respect to a manually parsed test corpus. Test data can either be a treebank constructed naturally occurring data, such as the \"\"Wall Street Corpus\"\", or a \"\"test suite\"\" containing constructed examples which cover all interesting linguistic phenomena. An important issue in parser evaluation is the comparison of parsers and grammars based on different linguistic theories. Evaluations have focussed on phrase structure or dependency structures."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Evaluation of broad-coverage natural language parsers"@en .

omtd:EvaluationOfMachineTranslationAndTranslationTools a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Evaluation of Machine Translation and translation tools"@en ;
    rdfs:comment "The task/process of assessing the quality performance of machine translation tools"@en ;
    skos:altLabel "Evaluation of MT"@en,
        "Evaluation of MT Systems"@en,
        "MT Evaluation"@en ;
    skos:broader omtd:Evaluation ;
    skos:definition "The growing number of MT systems on the market that span a wide range of quality levels has motivated activities towards evaluation standards from national and international organizations. Evaluation of MT systems depends strongly on whether such a system is used for information dissemination, assimilation, or in a conversational context, the types of texts to be translated, whether there is a well-defined and limited application domain and many more factors."@en,
        "The growing number of MT systems on the market that span a wide range of quality levels has motivated activities towards evaluation standards from national and international organisations. Evaluation of MT systems depends strongly on whether such a system is used for information dissemination, assimilation, or in a conversational context, the types of texts to be translated, whether there is a well-defined and limited application domain and many more factors."@en-gb ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Evaluation of Machine Translation and translation tools"@en .

omtd:ExtractionOfDomainSpecificInformation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Extraction of domain-specific information"@en ;
    rdfs:comment "Extraction of information that pertains to specific domains/disciplines; it can be used combined with \"\"Annotation type\"\" to specify the type of information extracted"@en,
        "Extraction of information that pertains to specific domains/disciplines; it can be used combined with \"Annotation type\" to specify the type of information extracted"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:ExtractionOfFundingInformation ;
    skos:prefLabel "Extraction of domain-specific information"@en .

omtd:FakeNewsDetection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Fake news detection"@en ;
    rdfs:comment "The process of detecting whether a certain news item is fake (i.e. a type of news items of yellow journalism or propaganda that consists of deliberate disinformation or hoaxes spread via traditional news media or online social media) [adapted from wikipedia]"@en ;
    skos:altLabel "Fake news assessment"@en,
        "Fake news evaluation"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Fake news detection"@en .

omtd:FeatureExtraction a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Feature extraction"@en ;
    dct:source <http://scikit-learn.org/stable/modules/feature_extraction.html> ;
    rdfs:comment "Feature extraction consists in transforming arbitrary data, such as text or images, into numerical features usable for machine learning"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:FrequencyCount ;
    skos:prefLabel "Feature extraction"@en .

omtd:FrameSemanticParsing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Frame-semantic parsing"@en ;
    rdfs:comment "The task/process of recognising and labelling in a text predicate argument structures and the semantic roles of the constituents, in accordance to the frame semantics theory"@en-gb,
        "The task/process of recognising and labeling in a text predicate argument structures and the semantic roles of the constituents, in accordance to the frame semantics theory"@en-us ;
    skos:broader omtd:Parsing,
        omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Frame-semantic parsing"@en .

omtd:ImageGeneration a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Image generation"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:TextToImageGeneration ;
    skos:prefLabel "Image generation"@en .

omtd:ImageTranslation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Image translation"@en ;
    rdfs:comment "The automatic extraction of text contained in an image (e.g. by OCR technology), its subsequent translation into another language, followed by a digital image processing step in order to reconstruct the original image with the translated text [adapted from https://en.wikipedia.org/wiki/Image_translation]"@en ;
    skos:broader omtd:Translation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Image translation"@en .

omtd:InformationFiltering a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Information filtering"@en ;
    rdfs:comment "The process/task of removing (filtering out) redundant or unwanted information from an information stream using (semi)automated or computerized methods prior to presentation to a human user; the selection of the items is based on the correlation between the content of the items and the user's preferences (content-based filtering) or the correlation between people with similar preferences (collaborative filtering)"@en,
        "The process/task of removing (filtering out) redundant or unwanted information from an information stream using (semi)automated or computerised methods prior to presentation to a human user; the selection of the items is based on the correlation between the content of the items and the user's preferences (content-based filtering) or the correlation between people with similar preferences (collaborative filtering)"@en-gb ;
    skos:broader omtd:InformationRetrieval ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:InformationFilteringByRecommenderSystems ;
    skos:prefLabel "Information filtering"@en .

omtd:Keyword a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Keyword"@en ;
    skos:broader omtd:ScholarlyAnalyticsEntity,
        omtd:ScholarlyCommunicationAnnotation,
        omtd:SemanticAnnotationType ;
    skos:definition "A word or group of words used to describe or index the contents of a document"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Keyword"@en .

omtd:Lemmatization a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lemmatization"@en,
        "Lemmatisation"@en-gb ;
    rdfs:comment "Lemmatisation  (or lemmatization) in linguistics is the process of grouping together the inflected forms of a word so they can be analysed as a single item, identified by the word's lemma, or dictionary form. [Wikipedia]"@en ;
    skos:broader omtd:TextAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lemmatization"@en,
        "Lemmatisation"@en-gb .

omtd:LexicalSimplification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexical simplification"@en ;
    rdfs:comment "The task of replacing individual words of a text with words that are easier to understand, so that the text as a whole becomes easier to comprehend, e.g. by people with learning disabilities or by children who learn to read [from https://link.springer.com/chapter/10.1007/978-3-642-28601-8_36]"@en ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lexical simplification"@en ;
    skos:related omtd:LexicalSubstitution .

omtd:LexicalSubstitution a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexical substitution"@en ;
    rdfs:comment "The task of identifying a substitute for a word in the context of a clause [from Wikipedia]"@en ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lexical substitution"@en ;
    skos:related omtd:Paraphrasing .

omtd:LexiconFormatConversion a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexicon format conversion"@en ;
    rdfs:comment "The task/process of converting the format of a lexical/conceptual resource into another (e.g. from TSV to XML)"@en ;
    skos:broader omtd:FormatConversion,
        omtd:SupportOperationForKnowledgeResources ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lexicon format conversion"@en .

omtd:LexiconViewing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexicon viewing"@en ;
    rdfs:comment "The task/process of viewing the contents of a lexicon as performed by human beings"@en ;
    skos:broader omtd:SupportOperationForKnowledgeResources,
        omtd:Viewing ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lexicon viewing"@en .

omtd:LexiconVisualization a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexicon visualization"@en,
        "Lexicon visualisation"@en-gb ;
    rdfs:comment "The task/process of visualizing information (e.g. using diagrams, 3-d images, word clouds etc.) contained in lexical/conceptual resources"@en,
        "The task/process of visualising information (e.g. using diagrams, 3-d images, word clouds etc.) contained in lexical/conceptual resources"@en-gb ;
    skos:broader omtd:SupportOperationForKnowledgeResources,
        omtd:Visualization ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lexicon visualization"@en,
        "Lexicon visualisation"@en-gb .

omtd:Matching a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Matching"@en ;
    rdfs:comment "The task/performance of identifying similar elements in two resources"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:GazeteerBasedMatching ;
    skos:prefLabel "Matching"@en .

omtd:MultilingualInformationRetrieval a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Multilingual Information Retrieval"@en ;
    rdfs:comment "Cross-language information retrieval means using queries in one language to search for documents in a different language. Multilingual information retrieval is a broader term, which includes the case where queries in different languages are used, but only for searching documents in the same language."@en ;
    skos:altLabel "MIR"@en ;
    skos:broader omtd:InformationRetrieval ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Multilingual Information Retrieval"@en ;
    skos:related omtd:CrossLingualSearch .

omtd:MultimodalIntegration a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Multimodal integration"@en ;
    rdfs:comment "The study of how information from the different sensory modalities, such as sight, sound, touch, smell, self-motion and taste, may be integrated by the nervous system [from Wikipedia]"@en ;
    skos:altLabel "Modality integration"@en,
        "Multisensory integration"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:definition "Multimodal fusion combines the output of speech understanding, gestures and mimic recognition (if available) to an uniform representation of the user intention."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Multimodal integration"@en .

omtd:MultimodalSynthesis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Multimodal synthesis"@en ;
    rdfs:comment "The generation of a multimodal output resource"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Multimodal synthesis"@en ;
    skos:related omtd:MultimodalIntegration .

omtd:NamedEntityRecognition a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Named Entity Recognition"@en ;
    rdfs:comment "A subtask of information extraction that seeks to locate and classify named entities in text into pre-defined categories such as the names of persons, organizations, locations, expressions of times, quantities, monetary values, percentages, etc."@en,
        "A subtask of information extraction that seeks to locate and classify named entities in text into pre-defined categories such as the names of persons, organisations, locations, expressions of times, quantities, monetary values, percentages, etc."@en-gb ;
    skos:altLabel "Entity Identification"@en,
        "Entity Recognition"@en,
        "Entity extraction"@en,
        "NER"@en,
        "NERC"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:definition "Named entity (NE) recognition is a form of information extraction in which the major task is to identify and classify from NL text every word or sequence of words as being a person-name, organization, location, date, time, monetary value, percentage expression. NE recognition has a high impact for a number of applications, like e.g., InterNet search engines, text data mining or answer extraction."@en,
        "Named entity (NE) recognition is a form of information extraction in which the major task is to identify and classify from NL text every word or sequence of words as being a person-name, organisation, location, date, time, monetary value, percentage expression. NE recognition has a high impact for a number of applications, like e.g., InterNet search engines, text data mining or answer extraction."@en-gb ;
    skos:editorialNote "can also be annotation"@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:NamedEntityDisambiguation ;
    skos:prefLabel "Named Entity Recognition"@en .

omtd:NaturalLanguageUnderstanding a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Natural Language Understanding"@en ;
    rdfs:comment "",
        "The comprehension by computers of the structure and meaning of human languages, allowing users to interact with the computer using natural sentences. [adapted from https://www.gartner.com/it-glossary/nlu-natural-language-understanding]"@en ;
    skos:altLabel "LU"@en,
        "Language Understanding"@en,
        "Machine Understanding"@en,
        "NLU"@en,
        "Natural Language Understanding"@en ;
    skos:broader omtd:Operation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:SpeechUnderstanding ;
    skos:prefLabel "Natural Language Understanding"@en .

omtd:ParallelSentenceExtraction a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Parallel sentence extraction"@en ;
    rdfs:comment "The task/process of identifying parallel sentences (i.e. sentences that have the same sense in different languages) in parallel texts"@en ;
    skos:broader omtd:MachineTranslationSupport ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Parallel sentence extraction"@en .

omtd:PhraseAlignment a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Phrase alignment"@en ;
    rdfs:comment "Alignment at phrase level"@en ;
    skos:broader omtd:Alignment ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Phrase alignment"@en .

omtd:PolarityLabelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Polarity labelling"@en-gb,
        "Polarity labeling"@en-us ;
    rdfs:comment "The task/process of adding to units of a text (especially in sentiment-intensive texts) tags that indicate polarity (negative, positive, neutral, mixed)"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Polarity labelling"@en-gb,
        "Polarity labeling"@en-us .

omtd:ProsodicAnnotation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Prosodic annotation"@en ;
    skos:broader omtd:SpeechAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:ProsodicSegmentation ;
    skos:prefLabel "Prosodic annotation"@en .

omtd:QuestionAnswering a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Question Answering"@en ;
    rdfs:comment "The task/process where computer systems try to automatically answer questions posed by users in the form of natural language"@en ;
    skos:altLabel "AE"@en,
        "Answer Extraction"@en,
        "QA"@en,
        "Textual Question Answering"@en ;
    skos:broader omtd:InformationExtraction,
        omtd:KnowledgeDiscovery ;
    skos:definition "Question answering or Answer extraction (AE) aims at retrieving those exact passages of a document that directly answer a given user question. AE is more ambitious than information retrieval and information extraction in that the retrieval results are short phrases, not entire documents, and in that the queries may be arbitrarily specific. It is less ambitious than full-fledged question answering in that the answers are not generated from a knowledge base but looked up in the text of documents."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Question Answering"@en .

omtd:Reading a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Reading"@en ;
    rdfs:comment "Getting access to the contents of an input resource"@en ;
    skos:broader omtd:ResourceAccess ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower <http://w3id.org/w3id.org/meta-share/omtd-share/Concordancing> ;
    skos:prefLabel "Reading"@en .

omtd:RelationExtraction a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Relation Extraction"@en ;
    rdfs:comment "The process/task of identifying and classifying relation mentions between entities in text and/or data"@en ;
    skos:altLabel "Relationship Extraction"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:definition "Automated or human-assisted acquisition of relations between concepts from textual or other data, usu. within a selected domain."@en ;
    skos:editorialNote "can also be annotation"@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Relation Extraction"@en .

omtd:SentenceAlignment a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Sentence alignment"@en ;
    rdfs:comment "Alignment at sentence level"@en ;
    skos:broader omtd:Alignment ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Sentence alignment"@en .

omtd:Species a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Species"@en ;
    skos:broader omtd:BiologicalEnity,
        omtd:NamedEntity ;
    skos:definition "A set of animals or plants in which the members have similar characteristics to each other and can breed with each other"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:narrower omtd:WheatRelatedSpecies ;
    skos:prefLabel "Species"@en .

omtd:SpeechAnalytics a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech analytics"@en ;
    skos:broader omtd:TextSpeechDataAnalytics ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech analytics"@en .

omtd:SpeechAnnotationType a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech annotation type"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:narrower omtd:ProsodicBoundary,
        omtd:Transcription1 ;
    skos:prefLabel "Speech annotation type"@en ;
    skos:topConceptOf omtd:AnnotationTypeScheme .

omtd:SpeechRetrieval a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech Retrieval"@en ;
    rdfs:comment "The process of retrieving spoken audio material (documents)in response to a search query"@en ;
    skos:altLabel "SDR"@en,
        "SR"@en,
        "Spoken Document Retrieval"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:definition "Speech Retrieval is the process of retrieving spoken audio material (documents)in response to a search query. Search queries can be spoken or textual. Speech retrieval makes use of techniques from speech recognition, natural language understanding and information retrieval. Possible applications are the indexing of archives of broadcast material, and monitoring of telephone conversations."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech Retrieval"@en .

omtd:SpeechSynthesis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech Synthesis"@en ;
    skos:altLabel "Synthetic Speech Generation"@en ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech Synthesis"@en .

omtd:SpeechSynthesisEvaluation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech Synthesis Evaluation"@en ;
    rdfs:comment "The task/process of evaluating speech synthesis systems"@en ;
    skos:altLabel "Evaluation of Speech Synthesis"@en ;
    skos:broader omtd:Evaluation ;
    skos:definition "Evaluation of speech synthesis traditionally considers intelligibility and naturalness. More recently, expressivity has become an issue with the increasing demand for expressive voices. Due to the multitude of aspects involved, there is no agreed standard for evaluation of speech synthesis systems. Since 2005, the Blizzard Challenge is an annual joint event for comparing speech synthesis technologies with a common database."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech Synthesis Evaluation"@en .

omtd:SpeechToSpeechTranslation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech-to-Speech translation"@en ;
    rdfs:comment "The process by which spoken utterances in one language are automatically translated and spoken aloud in another language"@en ;
    skos:broader omtd:Translation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech-to-Speech translation"@en .

omtd:SpeechUnderstanding a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech understanding"@en ;
    skos:broader omtd:NaturalLanguageUnderstanding,
        omtd:SpeechRecognition ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech understanding"@en .

omtd:SpokenLanguageGeneration a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Spoken Language Generation"@en ;
    rdfs:comment "The task of producing/generating spoken language"@en ;
    skos:altLabel "CTS"@en,
        "Concept-to-Speech generation"@en,
        "SLG"@en ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:definition "Whereas the generation of spoken language from semantic representations can be sequentialized into generation of text followed by text-to-speech, using text as an intermediate representation may lose information that was available in the original input, in particular related to information structure relevant for speech output. An integrated solution can avoid this problem and thereby lead to improved quality and/or simpler system architecture."@en,
        "Whereas the generation of spoken language from semantic representations can be sequentialised into generation of text followed by text-to-speech, using text as an intermediate representation may lose information that was available in the original input, in particular related to information structure relevant for speech output. An integrated solution can avoid this problem and thereby lead to improved quality and/or simpler system architecture."@en-gb ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Spoken Language Generation"@en .

omtd:Summarization a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Summarization"@en,
        "Summarisation"@en-gb ;
    rdfs:comment "The process/task of reducing one or more textual documents with a computer program in order to create a summary that retains the most important points of the original document(s)"@en ;
    skos:altLabel "ATS"@en,
        "Automatic Summarization"@en,
        "Automatic Text Summarization"@en,
        "TS"@en,
        "Text Summarization"@en,
        "Automatic Summarisation"@en-gb,
        "Automatic Text Summarisation"@en-gb,
        "Text Summarisation"@en-gb ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:definition "Text summarization is the process of distilling the most important information from a source (or sources) to produce an abridged version for a particular user (or users) and task (or tasks). Source: Mani, I. and Maybury, M. T., editors (1999), Advances in Automatic Text Summarization. MIT Press, Cambridge, Massachusetts."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Summarization"@en,
        "Summarisation"@en-gb .

omtd:TaskOrientedTextAnalysisEvaluation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Task-oriented text analysis evaluation"@en ;
    skos:broader omtd:Evaluation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Task-oriented text analysis evaluation"@en .

omtd:TemporalExpressionsLabelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Temporal expressions labelling"@en-gb,
        "Temporal expressions labeling"@en-us ;
    rdfs:comment "The task/process of determining the boundaries of units of text that denote time-related concepts and attaching to them tags that name these concepts (e.g. date, time, duration etc.)"@en ;
    skos:altLabel "Annotation of time"@en ;
    skos:broader omtd:SemanticAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:AnnotationOfDates ;
    skos:prefLabel "Temporal expressions labelling"@en-gb,
        "Temporal expressions labeling"@en-us .

omtd:TextAndDataAnalytics a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Text and Data Analytics"@en ;
    rdfs:comment "The process/task of converting unstructured text and data into high-quality structured data that can be further analysed to extract knowledge, support decision making etc."@en ;
    skos:broader omtd:TextSpeechDataAnalytics ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Text and Data Analytics"@en ;
    skos:related omtd:TextAndDataMining .

omtd:TextSimplification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Text simplification"@en ;
    rdfs:comment "The task of replacing textual segments (phrases, clauses, etc.) with other segments that have similar meaning but are easier to understand"@en ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Text simplification"@en ;
    skos:related omtd:LexicalSimplification .

omtd:TextSpeechDataAnalytics a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Text/Speech/Data analytics"@en ;
    skos:broader omtd:Operation ;
    skos:editorialNote "it could also be a composite concept created by three separate concepts, but for now ok"@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:SpeechAnalytics,
        omtd:TextAndDataAnalytics ;
    skos:prefLabel "Text/Speech/Data analytics"@en .

omtd:TextToVideoGeneration a omtd:Operation,
