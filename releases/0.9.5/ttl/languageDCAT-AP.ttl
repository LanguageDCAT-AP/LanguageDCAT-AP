omtd:TruthLabelling a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Truth labelling"@en-gb,
        "Truth labeling"@en-us ;
    rdfs:comment "The task of assigning a true/false tag to a news item, headline, claim, etc."@en ;
    skos:altLabel "Truth detection"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Truth labelling"@en-gb,
        "Truth labeling"@en-us .

omtd:UserAuthentication a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "User authentication"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "User authentication"@en .

omtd:Validation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Validation"@en ;
    rdfs:comment "The task/process of confirming that a system/data resource meets the specifications and fulfills its intended purpose"@en ;
    skos:broader omtd:Operation,
        omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Validation"@en .

omtd:VerbalAggressionAnalysis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Verbal aggression analysis"@en ;
    rdfs:comment "The task/process of recognizing evidence and the target(s) of verbal aggression usually in social media texts"@en,
        "The task/process of recognising evidence and the target(s) of verbal aggression usually in social media texts"@en-gb ;
    skos:altLabel "Verbal aggression classification"@en,
        "Verbal aggression detection"@en,
        "Verbal aggression identification"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Verbal aggression analysis"@en .

omtd:WheatRelatedSpecies a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Wheat-related species"@en ;
    skos:broader omtd:AgriculturalEntity,
        omtd:Species ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Wheat-related species"@en .

omtd:Word a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Word"@en ;
    skos:broader omtd:MorphologicalAnnotationType,
        omtd:StructuralAnnotationType ;
    skos:definition """A word is a unit which is a constituent at the phrase level and above. It is sometimes identifiable according to such criteria as (a) being the minimal possible unit in a reply, (b) having features such as a regular stress pattern, and phonological changes conditioned by or blocked at word boundaries, (c) being the largest unit resistant to insertion of new constituents within its boundaries, or (d) being the smallest constituent that can be moved within a sentence without making the sentence ungrammatical. A word is sometimes placed, in a hierarchy of grammatical constituents, above the morpheme level and below the phrase level. [http://www.glossary.sil.org/term/word]\r
  In annotation, words are often used as equivalent to tokens; thus, for instance, punctuation marks (traditionally not considered as words) will also be annotated as "word"."""@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:prefLabel "Word"@en .

omtd:WordSegmentation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Word segmentation"@en ;
    rdfs:comment "The task/process of segmenting (cutting) a word into root and affixes"@en ;
    skos:broader omtd:MorphologicalAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Word segmentation"@en .

omtd:WordSenseDisambiguation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Word Sense Disambiguation"@en ;
    rdfs:comment "The process/task of identifying which sense of a word with multiple meanings is used in a particular context; the selection of the sense is made from a list of the word's senses"@en ;
    skos:altLabel "WSD"@en ;
    skos:broader omtd:SupportOperation ;
    skos:definition "Word Sense Disambiguation is a subtask of semantic tagging, which consists of assigning a semantic class (sense) to a lexical item as specified by a semantic lexicon. If the semantic lexicon specifies more than one sense for a particular lexical item, a disambiguation procedure is needed to decide upon the most appropriate sense(s) for any given instance of the lexical item in text. WSD is not a self-contained application, but it may be included as an integrated part of a semantic processor."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Word Sense Disambiguation"@en .

omtd:Writing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Writing"@en ;
    rdfs:comment "The task/process of producing the output results of a process/workflow in various formats"@en ;
    skos:broader omtd:ResourceAccess ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Writing"@en .

omtd:ZeroShotClassification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Zero-Shot classification"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Zero-Shot classification"@en .

xsd:gYear a rdfs:Datatype .

xsd:gYearMonth a rdfs:Datatype .

adms:Identifier a owl:Class ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "This is based on the UN/CEFACT Identifier class. It consists of: a content string which is the identifier; an optional identifier for the identifier scheme; an optional identifier for the version of the identifier scheme; an optional identifier for the agency that manages the identifier scheme."@en .

dcat:Catalog a owl:Class ;
    rdfs:label "فهرس قوائم البيانات"@ar,
        "Katalog"@cs,
        "Katalog"@da,
        "Κατάλογος"@el,
        "Catalog"@en,
        "Catalogue"@en-gb,
        "Catálogo"@es,
        "Catalogue"@fr,
        "Catalogo"@it,
        "カタログ"@ja ;
    rdfs:comment "مجموعة من توصيفات قوائم البيانات"@ar,
        "Řízená kolekce metadat o datových sadách a datových službách"@cs,
        "En udvalgt og arrangeret samling af metadata om ressourcer (fx datasæt og datatjenester i kontekst af et datakatalog)."@da,
        "Μια επιμελημένη συλλογή μεταδεδομένων περί συνόλων δεδομένων"@el,
        "A curated collection of metadata about resources (e.g., datasets and data services in the context of a data catalog)."@en,
        "A curated collection of metadata about resources (e.g., datasets and data services in the context of a data catalogue)."@en-gb,
        "Una colección curada de metadatos sobre recursos (por ejemplo, conjuntos de datos y servicios de datos en el contexto de un catálogo de datos)."@es,
        "Une collection élaborée de métadonnées sur les jeux de données"@fr,
        "Una raccolta curata di metadati sulle risorse (ad es. sui dataset e relativi servizi nel contesto di cataloghi di dati)."@it,
        "データ・カタログは、データセットに関するキュレートされたメタデータの集合です。"@ja ;
    rdfs:isDefinedBy <http://www.w3.org/TR/vocab-dcat/> ;
    rdfs:subClassOf dcat:Dataset ;
    skos:definition "مجموعة من توصيفات قوائم البيانات"@ar,
        "Řízená kolekce metadat o datových sadách a datových službách."@cs,
        "En samling af metadata om ressourcer (fx datasæt og datatjenester i kontekst af et datakatalog)."@da,
        "Μια επιμελημένη συλλογή μεταδεδομένων περί συνόλων δεδομένων."@el,
        "A curated collection of metadata about resources (e.g., datasets and data services in the context of a data catalog)."@en,
        "A curated collection of metadata about resources (e.g., datasets and data services in the context of a data catalogue)."@en-gb,
        "Una colección curada de metadatos sobre recursos (por ejemplo, conjuntos de datos y servicios de datos en el contexto de un catálogo de datos)."@es,
        "Une collection élaborée de métadonnées sur les jeux de données."@fr,
        "Una raccolta curata di metadati sulle risorse (ad es. sui dataset e relativi servizi nel contesto di cataloghi di dati)."@it,
        "データ・カタログは、データセットに関するキュレートされたメタデータの集合です。"@ja ;
    skos:editorialNote "English, Italian, Spanish definitions updated in this revision. Multilingual text not yet updated."@en ;
    skos:scopeNote "Webový datový katalog je typicky reprezentován jako jedna instance této třídy."@cs,
        "Et webbaseret datakatalog repræsenteres typisk ved en enkelt instans af denne klasse."@da,
        "Συνήθως, ένας κατάλογος δεδομένων στον Παγκόσμιο Ιστό αναπαρίσταται ως ένα στιγμιότυπο αυτής της κλάσης."@el,
        "A web-based data catalog is typically represented as a single instance of this class."@en,
        "A web-based data catalogue is typically represented as a single instance of this class."@en-gb,
        "Normalmente, un catálogo de datos disponible en la web se representa como una única instancia de esta clase."@es,
        "Normalmente, un catalogo di dati nel web viene rappresentato come una singola istanza di questa classe."@it,
        "通常、ウェブ・ベースのデータ・カタログは、このクラスの1つのインスタンスとして表わされます。"@ja .

