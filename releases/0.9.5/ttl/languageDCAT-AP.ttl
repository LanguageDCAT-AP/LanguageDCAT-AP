        ms:encoder_only ;
    skos:prefLabel "transformer"@en .

omtd:BilingualLexiconInduction a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Bilingual lexicon induction"@en ;
    rdfs:comment "The task/process of inducing word translations from monolingual or comparable corpora in two languages"@en ;
    skos:broader omtd:KnowledgeAcquisition,
        omtd:SupportOperationForKnowledgeResources ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Bilingual lexicon induction"@en .

omtd:CoReferenceResolution a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Co-reference resolution"@en ;
    rdfs:comment "The process/task of determining all linguistic expressions that refer to the same entity in a certain text or across texts"@en ;
    skos:altLabel "Coreference resolution"@en ;
    skos:broader omtd:LinguisticAnalysis ;
    skos:definition "The process/task of identifying all linguistic expressions that appear in a certain text or across texts and refer to the same unique entity in the world"@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:IntraDocumentCoReferenceResolution ;
    skos:prefLabel "Co-reference resolution"@en ;
    skos:related omtd:AnaphoraResolution .

omtd:CrossLingualSearch a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Cross-language Information Retrieval"@en ;
    rdfs:comment "The ability of a system to retrieve relevant documents in various languages in response to a user query that is formulated in only one language"@en ;
    skos:altLabel "CLIR"@en,
        "Cross-lingual information retrieval"@en,
        "Cross-lingual search"@en,
        "Translingual information retrieval"@en ;
    skos:broader omtd:InformationRetrieval ;
    skos:definition "Cross-language information retrieval means using queries in one language to search for documents in a different language. Multilingual information retrieval is a broader term, which includes the case where queries in different languages are used, but only for searching documents in the same language."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Cross-language Information Retrieval"@en ;
    skos:related omtd:MultilingualInformationRetrieval .

omtd:DataCollection a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Data collection"@en ;
    dct:source <https://en.wikipedia.org/wiki/Data_collection> ;
    rdfs:comment "The process of gathering and measuring information on targeted variables in an established systematic fashion, which then enables one to answer relevant questions and evaluate outcomes"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:Crawling ;
    skos:prefLabel "Data collection"@en .

omtd:FormatConversion a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Format conversion"@en ;
    rdfs:comment "The task/process of converting (changing) the format of a resource into another (e.g. PDF to TXT or XML)"@en ;
    skos:altLabel "Data conversion"@en,
        "File conversion"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:DependencyConversion,
        omtd:LexiconFormatConversion ;
    skos:prefLabel "Format conversion"@en .

omtd:HumanComputerInteraction a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Human Computer Interaction"@en ;
    rdfs:comment "A multi-disciplinary research area focusing on the design and use of computer technology deployed in interfaces between humans and computers"@en ;
    skos:altLabel "HCI"@en,
        "Human Machine Interaction"@en ;
    skos:broader omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:AvatarSynthesis,
        omtd:ConversationalSystemsBuilding ;
    skos:prefLabel "Human Computer Interaction"@en .

omtd:LexiconAcquisitionFromCorpora a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexicon acquisition from corpora"@en ;
    rdfs:comment "The task/process of constructing lexical resources from corpora"@en ;
    skos:broader omtd:KnowledgeAcquisition,
        omtd:SupportOperationForKnowledgeResources ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lexicon acquisition from corpora"@en .

omtd:LexiconEnhancement a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexicon enhancement"@en ;
    rdfs:comment "The task/process of improving (e.g. increasing the size of entries, improving the information, adding new types of information, etc.) a lexicon"@en ;
    skos:broader omtd:KnowledgeAcquisition,
        omtd:SupportOperationForKnowledgeResources ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lexicon enhancement"@en .

omtd:LexiconExtractionFromLexica a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Lexicon extraction from lexica"@en ;
    rdfs:comment "The task/process of constructing lexical resources based on the restructuring of lexical information contained in lexica (e.g. by parsing definitions or using syntactic information attached to lemmas)"@en ;
    skos:broader omtd:KnowledgeAcquisition,
        omtd:SupportOperationForKnowledgeResources ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Lexicon extraction from lexica"@en .

omtd:MachineTranslation a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Machine Translation"@en ;
    rdfs:comment "The automatic translation of a text from one language into another performed by software without human involvement"@en ;
    skos:altLabel "Automated Translation"@en,
        "Automatic Translation"@en,
        "Computer Translation"@en,
        "MT"@en ;
    skos:broader omtd:Translation ;
    skos:definition "Machine Translation (MT) is the fully automatic translation from one human language into another one. Machine translation has been worked on since the 1950s. There are a number of commercial products available and in daily use, but there are still open research problems. Tranfer-based MT has a set of transfer rules for each language pair, so that n*(n-1) rule sets are necessary for MT between n languages. In contract, interlingua-based MT uses a language-independent representation into which all source languages are analysed and from which all target languages is generated. Most practically usable MT systems are tranfser-based. Recently, there have been interestinv developments in statistical MT algorithms which are trained on parallel corpora of translated texts, and are very useful for constructing MT systems for new language pairs."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Machine Translation"@en .

omtd:MorphosyntacticTagging a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Morphosyntactic tagging"@en ;
    rdfs:comment "The task/process of adding morphosyntactic tags to words in a text, i.e. part-of-speech and, optionally, morphological features per part-of-speech"@en ;
    skos:altLabel "Morphosyntactic annotation"@en ;
    skos:broader omtd:TextAnnotation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:BelowPosTagging,
        omtd:PosTagging ;
    skos:prefLabel "Morphosyntactic tagging"@en .

omtd:MultimediaInformationExtraction a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Multimedia Information Extraction"@en ;
    rdfs:comment "The process/task of automatically extracting structured information from multimedia data"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:definition "Multimedia Information Extraction can be considered as an extension of textual information extraction to multimedia documents, in an integrated view."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Multimedia Information Extraction"@en .

omtd:Paraphrasing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Paraphrasing"@en ;
    rdfs:comment "A task/process whereby a text fragment is reproduced with another text fragment that conveys the same or similar information"@en ;
    skos:broader omtd:NaturalLanguageGeneration,
        omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Paraphrasing"@en .

omtd:RecognizingTextualEntailment a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Recognizing Textual Entailment"@en,
        "Recognising Textual Entailment"@en-gb ;
    rdfs:comment "A task/process that intends to recognize for two text fragments whether the meaning of one text is entailed in that of the other, i.e. whether the truth of one text fragment follows from that of the other fragment"@en,
        "A task/process that intends to recognise for two text fragments whether the meaning of one text is entailed in that of the other, i.e. whether the truth of one text fragment follows from that of the other fragment"@en-gb ;
    skos:broader omtd:InformationExtraction,
        omtd:KnowledgeDiscovery ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Recognizing Textual Entailment"@en,
        "Recognising Textual Entailment"@en-gb .

omtd:ResourceAccess a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Resource access"@en ;
    rdfs:comment "Any operation that enables accessing a resource"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:Reading,
        omtd:Writing ;
    skos:prefLabel "Resource access"@en .

omtd:SignLanguageGeneration a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Sign language generation"@en ;
    rdfs:comment "The task/process of generating videos in sign language"@en ;
    skos:broader omtd:NaturalLanguageGeneration,
        omtd:OperationWithMultimediaInputOrOutput ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Sign language generation"@en .

omtd:TextToSpeechSynthesis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Text-to-Speech Synthesis"@en ;
    rdfs:comment "The task/process of converting speech into natural language text"@en ;
    skos:altLabel "TTS"@en,
        "Text to Speech Generation"@en,
        "Text to Speech Synthesis"@en ;
    skos:broader omtd:NaturalLanguageGeneration ;
    skos:definition "The generation of synthetic speech from text. Typically, a text-to-speech synthesis system performs a text analysis using natural language processing techniques; determines the appropriate phonetic string and prosodic features; and generates a speech signal by employing a concatenative or rule-based synthesis method."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:DocumentReading ;
    skos:prefLabel "Text-to-Speech Synthesis"@en .

omtd:Transcription a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Transcription"@en ;
    skos:altLabel "Speech transcription"@en,
        "Speech-to-Text conversion"@en ;
    skos:broader omtd:SpeechRecognition ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:OrthographicTranscription,
        omtd:PhoneticTranscription ;
    skos:prefLabel "Transcription"@en .

omtd:Viewing a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Viewing"@en ;
    rdfs:comment "The task/process of viewing the contents of a resource as performed by human beings"@en ;
    skos:broader omtd:SupportOperation ;
    skos:inScheme omtd:OperationScheme ;
    skos:narrower omtd:CorpusViewing,
        omtd:LexiconViewing ;
    skos:prefLabel "Viewing"@en .

dcat:DataService a owl:Class ;
    rdfs:label "Datatjeneste"@da,
        "Data service"@en,
        "Servicio de datos"@es,
        "Servizio di dati"@it ;
    rdfs:comment "Umístění či přístupový bod poskytující operace související s hledáním, přistupem k, či výkonem funkcí na datech či souvisejících zdrojích."@cs,
        "Et websted eller endpoint der udstiller operationer relateret til opdagelse af, adgang til eller behandlende funktioner på data eller relaterede ressourcer."@da,
        "A site or end-point providing operations related to the discovery of, access to, or processing functions on, data or related resources."@en,
        "Un sitio o end-point que provee operaciones relacionadas a funciones de descubrimiento, acceso, o procesamiento de datos o recursos relacionados."@es,
        "Un sito o end-point che fornisce operazioni relative alla scoperta, all'accesso o all'elaborazione di funzioni su dati o risorse correlate."@it ;
    rdfs:subClassOf dcmitype:Service,
        dcat:Resource ;
    skos:altLabel "Dataservice"@da ;
    skos:changeNote "Nová třída přidaná ve verzi DCAT 2.0."@cs,
        "Ny klasse tilføjet i DCAT 2.0."@da,
        "New class added in DCAT 2.0."@en,
        "Nueva clase añadida en DCAT 2.0."@es,
        "Nuova classe aggiunta in DCAT 2.0."@it ;
    skos:definition "Umístění či přístupový bod poskytující operace související s hledáním, přistupem k, či výkonem funkcí na datech či souvisejících zdrojích."@cs,
        "Et site eller endpoint der udstiller operationer relateret til opdagelse af, adgang til eller behandlende funktioner på data eller relaterede ressourcer."@da,
        "A site or end-point providing operations related to the discovery of, access to, or processing functions on, data or related resources."@en,
        "Un sitio o end-point que provee operaciones relacionadas a funciones de descubrimiento, acceso, o procesamiento de datos o recursos relacionados."@es,
        "Un sito o end-point che fornisce operazioni relative alla scoperta, all'accesso o all'elaborazione di funzioni su dati o risorse correlate."@it ;
    skos:scopeNote "Druh služby může být indikován vlastností dct:type. Její hodnota může být z řízeného slovníku, kterým je například slovník typů prostorových datových služeb INSPIRE."@cs,
        "Pokud je dcat:DataService navázána na jednu či více Datových sad, jsou tyto indikovány vlstností dcat:servesDataset."@cs,
        "Datatjenestetypen kan indikeres ved hjælp af egenskaben dct:type. Værdien kan tages fra kontrollerede udfaldsrum såsom INSPIRE spatial data service vocabulary."@da,
        "Hvis en dcat:DataService er bundet til en eller flere specifikke datasæt kan dette indikeres ved hjælp af egenskaben dcat:servesDataset."@da,
        "If a dcat:DataService is bound to one or more specified Datasets, they are indicated by the dcat:servesDataset property."@en,
        "The kind of service can be indicated using the dct:type property. Its value may be taken from a controlled vocabulary such as the INSPIRE spatial data service type vocabulary."@en,
        "El tipo de servicio puede indicarse usando la propiedad dct:type. Su valor puede provenir de un vocabulario controlado, como por ejemplo el vocabulario de servicios de datos espaciales de INSPIRE."@es,
        "Si un dcat:DataService está asociado con uno o más conjuntos de datos especificados, dichos conjuntos de datos pueden indicarse con la propiedad dcat:servesDataset."@es,
        "Il tipo di servizio può essere indicato usando la proprietà dct:type. Il suo valore può essere preso da un vocabolario controllato come il vocabolario dei tipi di servizi per dati spaziali di INSPIRE."@it,
        "Se un dcat:DataService è associato a uno o più Dataset specificati, questi sono indicati dalla proprietà dcat:serveDataset."@it .

