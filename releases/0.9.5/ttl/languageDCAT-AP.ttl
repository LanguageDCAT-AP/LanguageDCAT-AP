###  http://w3id.org/meta-share/omtd-share/Gzip
omtd:Gzip rdf:type owl:NamedIndividual ,
                   dct:MediaType ,
                   omtd:DataFormat ,
                   skos:Concept ;
          omtd:hasFileExtension "gz"@en ;
          rdfs:label "gzip"@en ;
          skos:broader omtd:PackageFormat ;
          skos:exactMatch <https://www.iana.org/assignments/media-types/application/gzip> ;
          skos:inScheme omtd:PackageFormatScheme ;
          skos:prefLabel "gzip"@en ;
          skos:topConceptOf omtd:PackageFormatScheme .

