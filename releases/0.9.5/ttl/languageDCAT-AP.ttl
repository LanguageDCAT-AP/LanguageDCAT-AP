omtd:other rdf:type owl:NamedIndividual ,
                    dct:MediaType ,
                    omtd:AnnotationType ,
                    omtd:DataFormat ,
                    omtd:Operation ,
                    skos:Concept ;
           rdfs:label "other"@en ;
           skos:definition "Value used when none of the recommended values of an element is appropriate for an item"@en ;
           skos:inScheme omtd:AnnotationTypeScheme ,
                         omtd:DataFormatScheme ,
                         omtd:OperationScheme ,
                         omtd:PackageFormatScheme ;
           skos:prefLabel "other"@en ;
           skos:topConceptOf omtd:AnnotationTypeScheme ,
                             omtd:DataFormatScheme ,
                             omtd:OperationScheme ,
                             omtd:PackageFormatScheme .

omtd:pkl a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Pickle"@en ;
    rdfs:comment "Python-specific serialization format that allows you to convert Python objects (like lists, dictionaries, classes, etc.) into a byte stream, which can then be stored in a file or transmitted over a network"@en,
        "Python-specific serialisation format that allows you to convert Python objects (like lists, dictionaries, classes, etc.) into a byte stream, which can then be stored in a file or transmitted over a network"@en-GB ;
    rdfs:seeAlso "https://docs.python.org/3/library/pickle.html" ;
    skos:altLabel "PKL"@en ;
    skos:broader omtd:MLModelFormat ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "Pickle"@en .

omtd:pmml a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "PMML"@en ;
    rdfs:comment "XML-based language that provides a way for applications to define statistical and data mining models and to share models between PMML compliant applications"@en ;
    rdfs:seeAlso "https://dmg.org/pmml/pmml-v4-2-1.html" ;
    skos:altLabel "Predictive Model Markup Language"@en ;
    skos:broader omtd:MLModelFormat ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "PMML"@en .

omtd:svg a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "SVG"@en ;
    omtd:hasFileExtension "svg" ;
    skos:altLabel "Scalable Vector Graphics"@en ;
    skos:broader omtd:ImageFormat ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "SVG"@en .

###  http://w3id.org/meta-share/omtd-share/unspecified
omtd:unspecified rdf:type owl:NamedIndividual ,
                          dct:MediaType ,
                          omtd:AnnotationType ,
                          omtd:DataFormat ,
                          omtd:Operation ,
                          skos:Concept ;
                 rdfs:label "unspecified"@en ;
                 skos:definition "Value used when none of the recommended values of an element is appropriate for an item"@en ;
                 skos:inScheme omtd:AnnotationTypeScheme ,
                               omtd:DataFormatScheme ,
                               omtd:OperationScheme ,
                               omtd:PackageFormatScheme ;
                 skos:prefLabel "unspecified"@en ;
                 skos:topConceptOf omtd:AnnotationTypeScheme ,
                                   omtd:DataFormatScheme ,
                                   omtd:OperationScheme ,
                                   omtd:PackageFormatScheme .


skos:ConceptScheme a owl:Class .

omtd:ANNIS a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "ANNIS"@en ;
    rdfs:seeAlso "http://korpling.github.io/ANNIS/3.6/user-guide/import-and-config-convert.html" ;
    skos:altLabel "relANNIS"@en ;
    skos:broader omtd:AnnotationFormat,
        omtd:DatabaseFormat ;
    skos:definition "Relational database format used in the ANNIS architecture (https://corpus-tools.org/annis/)"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "ANNIS"@en .

omtd:AlvisEnrichedDocumentFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "ALVIS Enriched Document format"@en ;
    rdfs:seeAlso "http://www.lrec-conf.org/proceedings/lrec2006/pdf/742_pdf.pdf" ;
    skos:broader omtd:AnnotationFormat,
        omtd:Xml ;
    skos:definition "Format for linguistic annotations of documents used for the ALVIS framework"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "ALVIS Enriched Document format"@en .

omtd:BncFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "BNC format"@en ;
    rdfs:seeAlso "https://dkpro.github.io/dkpro-core/releases/1.8.0/docs/format-reference.html#format-de.tudarmstadt.ukp.dkpro.core.io.bnc-asl" ;
    skos:broader omtd:CorpusFormat,
        omtd:Xml ;
    skos:definition "Data format for the XML version of the British National Corpus (http://www.natcorp.ox.ac.uk/)"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "BNC format"@en .

omtd:EAF a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "EUDICO annotation format"@en ;
    omtd:hasMimetype "text/x-eaf+xml" ;
    rdfs:seeAlso "https://www.mpi.nl/corpus/html/elan_ug/ch01.html" ;
