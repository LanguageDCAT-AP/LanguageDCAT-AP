omtd:SpeakerIdentification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speaker identification"@en ;
    rdfs:comment "The task/process of identifying/recognizing who the person speaking is"@en,
        "The task/process of identifying/recognising who the person speaking is"@en-gb ;
    skos:altLabel "SR"@en,
        "Speaker Recognition"@en,
        "VR"@en,
        "Voice Recognition"@en ;
    skos:broader omtd:SpeechRecognition ;
    skos:definition "Speaker recognition, which can be classified into identification and verification, is the process of automatically recognizing who is speaking on the basis of individual information included in speech waves. This technique makes it possible to use the speaker's voice to verify their identity and control access to services such as voice dialing, banking by telephone, telephone shopping, database access services, information services, voice mail, security control for confidential information areas, and remote access to computers."@en,
        "Speaker recognition, which can be classified into identification and verification, is the process of automatically recognising who is speaking on the basis of individual information included in speech waves. This technique makes it possible to use the speaker's voice to verify their identity and control access to services such as voice dialing, banking by telephone, telephone shopping, database access services, information services, voice mail, security control for confidential information areas, and remote access to computers."@en-gb ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speaker identification"@en .

omtd:SpeakerVerification a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speaker verification"@en ;
    rdfs:comment "The task/process of verifying that a certain person is speaking"@en ;
    skos:broader omtd:SpeechRecognition ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speaker verification"@en .

omtd:SpeechAct a omtd:AnnotationType,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech act"@en ;
    skos:broader omtd:DiscourseAnnotationType ;
    skos:definition "A speech act is an act that a speaker performs when making an utterance, including the following: (a) A general act (illocutionary act) that a speaker performs, analyzable as including: the uttering of words (utterance acts), making reference and predicating (propositional acts), and a particular intention in making the utterance (illocutionary force). (b) An act involved in the illocutionary act, including utterance acts and propositional acts, (c) The production of a particular effect in the addressee (perlocutionary act) [http://www.glossary.sil.org/term/speech-act]"@en ;
    skos:inScheme omtd:AnnotationTypeScheme ;
    skos:narrower omtd:DialogueAct ;
    skos:prefLabel "Speech act"@en .

omtd:SpeechAnalysis a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech analysis"@en ;
    skos:broader omtd:SpeechRecognition ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech analysis"@en .

omtd:SpeechEnhancement a omtd:Operation,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Speech Enhancement"@en ;
    rdfs:comment "The improvement of speech intelligibility by removing background noise from the speech signal"@en ;
    skos:broader omtd:SpeechRecognition ;
    skos:definition "The improvement of speech intelligibility by removing background noise from the speech signal. Due to the complexity of speech acoustics and perception, no simple mathematical error criterion can be applied; instead, algorithms and measures need to be developed which accomodate human perception."@en ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Speech Enhancement"@en .

omtd:SpeechToTextTranslation a omtd:Operation,
