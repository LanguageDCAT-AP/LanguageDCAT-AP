        skos:Concept ;
    rdfs:label "Stance detection"@en ;
    rdfs:comment "The extraction of a subject’s reaction to a claim made by a primary actor [http://nlpprogress.com/english/stance_detection.html]"@en ;
    skos:broader omtd:InformationExtraction ;
    skos:inScheme omtd:OperationScheme ;
    skos:prefLabel "Stance detection"@en .

