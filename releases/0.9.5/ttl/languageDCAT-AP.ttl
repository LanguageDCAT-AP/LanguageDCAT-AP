        "analitična razlaga"@sl,
        "аналитичка дефиниција"@sr ;
    lexmeta:lexbibWikibaseEntity lexbib:Q14448 ;
    rdfs:comment "the classical formula to explain the meaning of a word or phrase usingthe genus (generic term) and differentia (distinguishing feature orfeatures) formula; also called logical definition (e.g. triangle – aplane figure (genus) that has three straight bounding sides (differentia)."@en ;
    skos:altLabel "intensionel definition"@da,
        "logisk definition"@da,
        "fræðileg skýring"@is,
        "definizione logica"@it,
        "loginė apibrėžtis"@lt,
        "leksikografska razlaga"@sl ;
    skos:broader lexmeta:definition ;
    skos:inScheme lexmeta:MicrostructureFeatureScheme ;
    skos:prefLabel "definició analítica"@ca,
        "analytisk definition"@da,
        "analytische Definition"@de,
        "analytical definition"@en,
        "definición analítica"@es,
        "analüütiline definitsioon"@et,
        "definizio analitiko"@eu,
        "fræðileg skilgreining"@is,
        "definizione analitica"@it,
        "analitinė apibrėžtis"@lt,
        "definicja klasyczna"@pl,
        "definiție analitică"@ro,
        "analitična razlaga"@sl,
        "аналитичка дефиниција"@sr .

lexmeta:antedating a lexmeta:MicrostructureFeature,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "primer testimoni"@ca,
        "tilbagedatering"@da,
        "antedating"@en,
        "primera documentación"@es,
        "varaseim esitus"@et,
        "lehen lekukotasun"@eu,
        "antecedente"@it,
        "ankstyviausias paliudijimas"@lt,
        "antydatowanie"@pl,
        "antedatare"@ro,
        "антидатирање"@sr ;
    lexmeta:lexbibWikibaseEntity lexbib:Q14320 ;
    lexmeta:wikidataEntity wikidata:Q17012656 ;
    rdfs:comment "citation selection from the earliest possible sources; evidence of the occurrenceof a word or phrase given in an historical dictionary."@en ;
    skos:altLabel "primera documentació"@ca,
        "testimoni més antic"@ca,
        "documentación más antigua"@es,
        "istorinis paliudijimas"@lt,
        "antedatowanie"@pl ;
    skos:broader lexmeta:formalInformation ;
