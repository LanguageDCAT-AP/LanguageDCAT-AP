omtd:hasFileExtension a owl:DatatypeProperty ;
    rdfs:label "has file extension"@en ;
    rdfs:comment "The file extension usually associated with a specific data format (e.g. txt for plain text files, pdf for PDF files etc.)"@en ;
    rdfs:domain dct:MediaType ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

omtd:hasMimetype a owl:DatatypeProperty ;
    rdfs:label "has mimetype"@en ;
    rdfs:comment "Relates a data format to a mimetype following the IANA specifications, yet not officially recognised by IANA; it can be the exact or a broader mimetype and it is recorded here as found in various documents"@en ;
    rdfs:domain dct:MediaType ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

