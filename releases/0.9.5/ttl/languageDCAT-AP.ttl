    skos:broader omtd:CorpusFormat,
        omtd:Xml ;
    skos:definition "Data format for plain XML files"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "text/XML"@en .

omtd:VideoFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Video format"@en ;
    skos:definition "Any format used for video files"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:avi ;
    skos:prefLabel "Video format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

omtd:WikiFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Wiki format"@en ;
    skos:definition "Superclass for wiki formats"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:MediaWikiMarkup ;
    skos:prefLabel "Wiki format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

omtd:Xmi a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "XMI"@en ;
    omtd:hasFileExtension "xmi" ;
    rdfs:seeAlso "https://www.iana.org/assignments/media-types/application/vnd.xmi+xml" ;
    skos:broader omtd:DocumentFormat,
        omtd:Xml ;
    skos:definition "Data format for the XML Metadata Interchange (XMI), which is an Object Management Group (OMG) standard for exchanging metadata information via Extensible Markup Language (XML)"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "XMI"@en .

omtd:protoBuf a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "ProtoBuf"@en ;
    omtd:hasMimetype "application/protobuf" ;
    rdfs:comment "Language-neutral, platform-neutral, extensible mechanism for serializing structured data"@en,
        "Language-neutral, platform-neutral, extensible mechanism for serialising structured data"@en-GB ;
    rdfs:seeAlso "https://protobuf.dev/" ;
    skos:altLabel "Protocol Buffers"@en ;
    skos:broader omtd:MLModelFormat ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "ProtoBuf"@en .

omtd:DatabaseFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Database format"@en ;
    skos:definition "Formats used for databases"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:ANNIS,
        omtd:Jdbc ;
    skos:prefLabel "Database format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

omtd:Nif a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "NIF"@en ;
    rdfs:seeAlso "http://persistence.uni-leipzig.org/nlp2rdf/" ;
    skos:altLabel "NLP Interchage Format"@en ;
    skos:broader omtd:AnnotationFormat,
        omtd:CorpusFormat,
        omtd:RdfFormat ;
    skos:definition "The NLP Interchange Format (NIF) is an RDF/OWL-based format that aims to achieve interoperability between Natural Language Processing (NLP) tools, language resources and annotations ; it consists of specifications, ontologies and software (overview), which are combined under the version identifier \"NIF 2.0\", but are versioned individually"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "NIF"@en .

omtd:OpenOfficeDocument a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Open office document"@en ;
    skos:broader omtd:DocumentFormat,
        omtd:OpenFormat,
        omtd:Xml ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "Open office document"@en .

omtd:Ptb a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "PTB"@en ;
    skos:broader omtd:AnnotationFormat ;
    skos:definition "Penn Tree Bank formats"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:PtbChunked,
        omtd:PtbCombined ;
    skos:prefLabel "PTB"@en .

omtd:RdfFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "RDF format"@en ;
    skos:definition "Formats for RDF (Resource Description Framework) resources"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:Nif,
        omtd:Obo ;
    skos:prefLabel "RDF format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

omtd:TabularFormat a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Tabular format"@en ;
    skos:definition "Any format based on columns"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:ConllFormat,
        omtd:Imscwb ;
    skos:prefLabel "Tabular format"@en ;
    skos:topConceptOf omtd:DataFormatScheme .

omtd:Tcf a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "TCF"@en ;
    omtd:hasMimetype "text/tcf+xml" ;
    rdfs:seeAlso "https://weblicht.sfs.uni-tuebingen.de/weblichtwiki/index.php/The_TCF_Format" ;
    skos:altLabel "Text Corpus Format"@en ;
    skos:broader omtd:AnnotationFormat,
        omtd:CorpusFormat,
        omtd:Xml ;
    skos:definition "An XML data exchange format developed within the WebLicht architecture to facilitate efficient interoperability between the tools ; it allows the various linguistic annotations produced by the tools within WebLicht to be stored in one document ; it supports incremental enrichment of linguistic annotations at various levels of analysis in a stand-­off XML‐based format"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "TCF"@en .

omtd:TigerXml a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Tiger XML"@en ;
    omtd:hasMimetype "application/x.org.dkpro.tiger+xml" ;
    rdfs:seeAlso "http://www.ims.uni-stuttgart.de/forschung/ressourcen/werkzeuge/TIGERSearch/doc/html/TigerXML.html",
        "https://dkpro.github.io/dkpro-core/releases/1.8.0/docs/format-reference.html#format-de.tudarmstadt.ukp.dkpro.core.io.tiger-asl" ;
    skos:broader omtd:AnnotationFormat,
        omtd:CorpusFormat,
        omtd:Xml ;
    skos:definition "The TIGER XML format was created for encoding syntactic constituency structures in the German TIGER corpus. It has since been used for many other corpora as well. TIGERSearch is a linguistic search engine specifically targetting this format. The format has later been extended to also support semantic frame annotations."@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "Tiger XML"@en .

omtd:Tuepp a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Tuepp"@en ;
    omtd:hasMimetype "application/x.org.dkpro.tuepp+xml" ;
    rdfs:seeAlso "http://dkpro.github.io/dkpro-core/releases/1.8.0/docs/format-reference.html#format-de.tudarmstadt.ukp.dkpro.core.io.tuepp-asl",
        "https://zoidberg.ukp.informatik.tu-darmstadt.de/jenkins/job/DKPro%20Core%20Documentation%20(GitHub)/de.tudarmstadt.ukp.dkpro.core$de.tudarmstadt.ukp.dkpro.core.doc-asl/doclinks/5/format-reference.html#format-Tuepp" ;
    skos:broader omtd:AnnotationFormat,
        omtd:CorpusFormat,
        omtd:Xml ;
    skos:definition "Format of the Tübingen Partially Parsed Corpus of Written German (TüPP-D/Z) XML files ; TüPP D/Z (http://www.sfs.uni-tuebingen.de/de/ascl/ressourcen/corpora/tuepp-dz.html) is a collection of articles from the German newspaper taz (die tageszeitung) annotated and encoded in a XML format."@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:prefLabel "Tuepp"@en .

omtd:Xces a dct:MediaType,
        omtd:DataFormat,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "XCES"@en ;
    omtd:hasMimetype "application/x-xces+xml" ;
    skos:broader omtd:AnnotationFormat,
        omtd:Xml ;
    skos:definition "Data format for documents and corpora using the XCES standard (Corpus Encoding Standard for XML), cf. http://www.xces.org/"@en ;
    skos:inScheme omtd:DataFormatScheme ;
    skos:narrower omtd:XcesIlspVariant ;
    skos:prefLabel "XCES"@en .

